    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Heroes Dawn Unity/Packages/com.n29.heroesdawn.domain/**/*.cs" />
    <Compile Include="../../Heroes Dawn Unity/Assets/_Project/Content/**/*.cs" />
    <Compile Include="../../Heroes Dawn Unity/Assets/Tests/Domain/SkeletonTests.cs" />
    <Compile Include="../../Heroes Dawn Unity/Assets/Tests/Domain/Core/**/*.cs" />
    <Compile Include="../../Heroes Dawn Unity/Assets/Tests/Domain/Definitions/**/*.cs" />
    <Compile Include="../../Heroes Dawn Unity/Assets/Tests/Domain/Board/**/*.cs" />
