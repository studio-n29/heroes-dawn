    narrationBefore:
    - speaker: enforcer
      text: "On vide le b\xE2timent. \xC7a sera plus simple pour tout le monde."
      key: narration.ny_3_2.elite.before.0
      route: 
      replaces: 
    - speaker: dr_colby
      text: "Plus simple pour qui ? Pas pour les gens couch\xE9s derri\xE8re moi."
      key: narration.ny_3_2.elite.before.1
      route: 
      replaces: 
    narrationAfter:
    - speaker: lucas_mendes
      text: "L'entr\xE9e tient. Les patients sont \xE0 l'abri."
      key: narration.ny_3_2.elite.after.0
