    narrationBefore:
    - speaker: narrateur
      text: "La clinique occupe une ancienne \xE9glise. Un groupe \xE9lectrog\xE8ne tousse dans la cour, et une file de bless\xE9s attend \xE0 la porte."
      key: narration.ny_3_2.intro.0
      route: 
      replaces: 
    - speaker: giulia_rossi
      text: Il n'y a ni badge ni formulaire. Ils entrent, c'est tout.
      key: narration.ny_3_2.intro.1
      route: 
      replaces: 
    - speaker: dr_colby
      text: "\xC9vacuer ? Les h\xF4pitaux du centre n'admettent personne de ce quartier. Ils ne soignent qu'ici. Si je pars, ils n'ont nulle part."
      key: narration.ny_3_2.intro.2
      route: 
      replaces: 
    - speaker: ilona_varga
      text: "Elle ne cherche pas \xE0 \xEAtre courageuse. Elle a fait ses comptes."
      key: narration.ny_3_2.intro.3
      route: 
      replaces: 
    - speaker: agent_d
      text: Alors on tient la clinique. Dites-nous seulement quelle porte ne doit jamais tomber.
      key: narration.ny_3_2.intro.4
      route: 
      replaces: 
    - speaker: agent_m
      text: "Je vois par o\xF9 ils vont entrer. Dites-moi seulement quelle porte vous voulez garder."
      key: narration.ny_3_2.intro.4.m
      route: agent_m
      replaces: narration.ny_3_2.intro.4
    narrationAfter: []
