    narrationBefore:
    - speaker: narrateur
      text: "Les hologrammes saluent l'Aube par son nom. Les quais sont balay\xE9s, les sourires parfaits."
      key: narration.mos_1_1.intro.0
      route: 
      replaces: 
    - speaker: giulia_rossi
      text: "On dirait qu'ils attendaient un chef d'\xC9tat."
      key: narration.mos_1_1.intro.1
      route: 
      replaces: 
    - speaker: ilona_varga
      text: Ils attendaient quelqu'un. Je ne sais pas encore qui.
      key: narration.mos_1_1.intro.2
      route: 
      replaces: 
    - speaker: agent_m
      text: "Ces quais ont \xE9t\xE9 lav\xE9s cette nuit. Je vois les balais, les seaux\u2026 et personne n'a dormi."
      key: narration.mos_1_1.intro.3
      route: 
      replaces: 
    - speaker: agent_d
      text: "Ils ont lav\xE9 ces quais pour nous. \xC0 New York, on cache les cam\xE9ras, pas les balais."
      key: narration.mos_1_1.intro.3.d
      route: agent_d
      replaces: narration.mos_1_1.intro.3
    - speaker: lucas_mendes
      text: "Un accueil de cette qualit\xE9, \xE7a se pr\xE9pare des jours \xE0 l'avance."
      key: narration.mos_1_1.intro.4
      route: 
      replaces: 
    - speaker: ilona_varga
      text: "Ou \xE7a sert \xE0 nous garder les yeux sur la fa\xE7ade."
      key: narration.mos_1_1.intro.5
      route: 
      replaces: 
    - speaker: agent_m
      text: "Cette odeur de cire et d'encens sur un quai de gare\u2026 je la connais."
      key: narration.mos_1_1.intro.6
      route: agent_m
      replaces: 
    narrationAfter: []
