    narrationBefore:
    - speaker: enforcer
      text: "Bienvenue \xE0 Moscou. Le comit\xE9 d'accueil vous prie de rebrousser chemin."
      key: narration.mos_1_1.elite.before.0
      route: 
      replaces: 
    - speaker: ilona_varga
      text: Un accueil trop parfait cache toujours quelque chose.
      key: narration.mos_1_1.elite.before.1
      route: 
      replaces: 
    narrationAfter:
    - speaker: agent_m
      text: "Ce cargo scell\xE9 n'est sur aucun manifeste. Je vois les camions qui l'ont d\xE9pos\xE9\u2026 trois jours avant nous."
      key: narration.mos_1_1.elite.after.0
      route: 
      replaces: 
    - speaker: lucas_mendes
      text: "Trois jours ? Avant m\xEAme qu'on d\xE9cide de venir ?"
      key: narration.mos_1_1.elite.after.1
      route: 
      replaces: 
    - speaker: agent_m
      text: "Avant m\xEAme qu'on d\xE9cide de venir."
      key: narration.mos_1_1.elite.after.2
      route: 
      replaces: 
