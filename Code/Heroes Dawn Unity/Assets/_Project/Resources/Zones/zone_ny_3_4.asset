    narrationBefore:
    - speaker: narrateur
      text: "La rue de l'atelier est \xE9troite, les volets ferm\xE9s. Des tags couvrent les murs : la signature du gang."
      key: narration.ny_3_4.intro.0
      route: 
      replaces: 
    - speaker: lucas_mendes
      text: "Il n'y a personne dans cette rue, mais les fen\xEAtres nous regardent."
      key: narration.ny_3_4.intro.1
      route: 
      replaces: 
    - speaker: giulia_rossi
      text: Ils nous attendent. Chaque porte est tenue.
      key: narration.ny_3_4.intro.2
      route: 
      replaces: 
