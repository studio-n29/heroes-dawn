    narrationBefore:
    - speaker: narrateur
      text: Le couvre-feu tombe sans annonce. Les volets se ferment, les rues se vident, et des civils restent dehors.
      key: narration.mos_4_1.intro.0
      route: 
      replaces: 
    - speaker: giulia_rossi
      text: "Aucune sir\xE8ne, aucun avis. Juste des patrouilles qui ne portent pas d'insigne."
      key: narration.mos_4_1.intro.1
      route: 
      replaces: 
    - speaker: civil_moscou
      text: "Ils nous ont dit de rentrer. Mais la porte est de l'autre c\xF4t\xE9 de leurs barrages."
      key: narration.mos_4_1.intro.2
      route: 
      replaces: 
    - speaker: agent_m
      text: On vous ouvre un passage. Suivez-nous, ne courez pas.
      key: narration.mos_4_1.intro.3
      route: 
      replaces: 
    - speaker: agent_d
      text: Suivez-moi. Je trace le chemin. Ne regardez pas les barrages.
      key: narration.mos_4_1.intro.3.d
      route: agent_d
      replaces: narration.mos_4_1.intro.3
    narrationAfter: []
