    narrationBefore:
    - speaker: enforcer
      text: "Ordre de fermeture. Pas d'ordre \xE9crit, mais un ordre."
      key: narration.mos_4_1.elite.before.0
      route: 
      replaces: 
    - speaker: ilona_varga
      text: "Il ne sait pas qui l'a donn\xE9. Il ob\xE9it quand m\xEAme."
      key: narration.mos_4_1.elite.before.1
      route: 
      replaces: 
    narrationAfter:
    - speaker: lucas_mendes
      text: "Les civils sont \xE0 l'abri. Les barrages sont lev\xE9s."
      key: narration.mos_4_1.elite.after.0
      route: 
      replaces: 
