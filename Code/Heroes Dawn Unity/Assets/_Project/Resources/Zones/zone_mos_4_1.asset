    narrationBefore: []
    narrationAfter:
    - speaker: giulia_rossi
      text: "Quelqu'un nous regarde, l\xE0-bas, sous le porche. Pas de costume, pas d'insigne."
      key: narration.mos_4_1.exit.0
      route: 
      replaces: 
    - speaker: ilona_varga
      text: "Il a un badge dissimul\xE9 sous son manteau. Je connais ce sigle."
      key: narration.mos_4_1.exit.1
      route: 
      replaces: 
    - speaker: agent_m
      text: "L'AMIF. Elle \xE9tait \xE0 Moscou depuis le d\xE9but : elle ne s'est montr\xE9e qu'ici."
      key: narration.mos_4_1.exit.2
      route: 
      replaces: 
    - speaker: agent_d
      text: "New York avait Stroke. Ici, l'AMIF reste dans l'ombre d'un \xC9tat. C'est plus patient."
      key: narration.mos_4_1.exit.3
      route: agent_d
      replaces: 
