    narrationBefore:
    - speaker: narrateur
      text: "Le blackout a laiss\xE9 les immeubles de Harlem sans courant, sans pression, sans pompiers. Celui-ci br\xFBle depuis une heure."
      key: narration.ny_3_1.intro.0
      route: 
      replaces: 
    - speaker: giulia_rossi
      text: "Il reste des gens \xE0 tous les \xE9tages. J'entends des enfants."
      key: narration.ny_3_1.intro.1
      route: 
      replaces: 
    - speaker: habitant
      text: "Mon voisin dit que c'\xE9tait un court-circuit. Un court-circuit qui sent l'essence ?"
      key: narration.ny_3_1.intro.2
      route: 
      replaces: 
    - speaker: agent_d
      text: On ouvre l'escalier de service. Je vous fais une passerelle. Tenez la rampe et ne regardez pas en bas.
      key: narration.ny_3_1.intro.3
      route: 
      replaces: 
    - speaker: agent_m
      text: "Je vois quel \xE9tage c\xE9dera en premier. On \xE9vacue dans cet ordre."
      key: narration.ny_3_1.intro.3.m
      route: agent_m
      replaces: narration.ny_3_1.intro.3
    - speaker: lucas_mendes
      text: "Le plafond du troisi\xE8me ne tiendra pas. On a quatre minutes."
      key: narration.ny_3_1.intro.4
      route: 
      replaces: 
