    narrationBefore:
    - speaker: enforcer
      text: "Personne ne sort. Les locataires ont re\xE7u une offre, ils vont l'accepter."
      key: narration.ny_3_1.elite.before.0
      route: 
      replaces: 
    - speaker: ilona_varga
      text: "Il parle d'offre pendant que le bloc br\xFBle. Il n'a m\xEAme pas honte."
      key: narration.ny_3_1.elite.before.1
      route: 
      replaces: 
