    narrationBefore: []
    narrationAfter:
    - speaker: habitant
      text: Des hommes sont venus hier pour nous proposer de racheter l'immeuble. Nous avons dit non.
      key: narration.ny_3_1.exit.0
      route: 
      replaces: 
    - speaker: ilona_varga
      text: "Ils ont chang\xE9 la r\xE9ponse eux-m\xEAmes."
      key: narration.ny_3_1.exit.1
      route: 
      replaces: 
    - speaker: agent_d
      text: "Je suis n\xE9 \xE0 trois rues d'ici. J'ai dessin\xE9 sur ce mur quand j'avais quinze ans. Il n'en reste plus rien."
      key: narration.ny_3_1.exit.2
      route: agent_d
      replaces: 
