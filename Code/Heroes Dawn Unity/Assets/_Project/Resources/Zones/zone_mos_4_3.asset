    narrationBefore:
    - speaker: agent_amif
      text: "Il est temps de vous retirer. Ce dossier n'est pas le v\xF4tre."
      key: narration.mos_4_3.elite.before.0
      route: 
      replaces: 
    - speaker: conseiller
      text: "Vous n'avez pas \xE9t\xE9 invit\xE9, monsieur. Mes hommes vont vous raccompagner."
