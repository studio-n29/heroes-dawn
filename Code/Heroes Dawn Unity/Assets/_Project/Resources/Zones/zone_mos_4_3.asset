    narrationBefore:
    - speaker: narrateur
      text: "La salle du conseil est ronde, bois\xE9e, silencieuse. Une seule chaise est occup\xE9e."
      key: narration.mos_4_3.intro.0
      route: 
      replaces: 
    - speaker: conseiller
      text: "Soyez les bienvenus. J'ai longtemps attendu une visite aussi pr\xE9cise."
      key: narration.mos_4_3.intro.1
      route: 
      replaces: 
    - speaker: conseiller
      text: Mademoiselle, je vous attendais surtout vous.
      key: narration.mos_4_3.intro.1.m
      route: agent_m
      replaces: narration.mos_4_3.intro.1
    - speaker: conseiller
      text: "L'AMIF vous pourchasse. Elle pr\xE9l\xE8ve et revend vos semblables. Je peux la chasser de cette ville."
      key: narration.mos_4_3.intro.2
      route: 
      replaces: 
    - speaker: conseiller
      text: "En \xE9change de votre neutralit\xE9. Laissez Moscou r\xE9gler ses affaires, et l'Aube sera libre de partir."
      key: narration.mos_4_3.intro.3
      route: 
      replaces: 
    - speaker: ilona_varga
      text: "Il parle de neutralit\xE9. Il parle de libert\xE9. Il ne parle ni de ses troph\xE9es ni de ses laboratoires."
      key: narration.mos_4_3.intro.4
      route: 
      replaces: 
    - speaker: agent_m
      text: "La cire sur ses mains. Le m\xEAme parfum. C'est lui."
      key: narration.mos_4_3.intro.5
      route: agent_m
      replaces: 
    narrationAfter: []
