    narrationBefore:
    - speaker: narrateur
      text: "Flushing grouille. Chaque \xE9tal a sa cam\xE9ra au-dessus de la caisse, et personne ne l\xE8ve les yeux."
      key: narration.ny_2_1.intro.0
      route: 
      replaces: 
    - speaker: giulia_rossi
      text: "Dix cam\xE9ras sur un march\xE9 d'oignons. Le Syndicat ne rate pas une transaction."
      key: narration.ny_2_1.intro.1
      route: 
      replaces: 
    - speaker: lucas_mendes
      text: "Ou quelqu'un lui pr\xEAte le mat\xE9riel."
      key: narration.ny_2_1.intro.2
      route: 
      replaces: 
    - speaker: commercant
      text: "Elles tournent depuis l'\xE9t\xE9. Elles nous voient. Elles ne nous aident jamais."
      key: narration.ny_2_1.intro.3
      route: 
      replaces: 
    - speaker: agent_d
      text: "Si on les coupe d'un coup, tout le march\xE9 le saura. On y va \xE9tal par \xE9tal."
      key: narration.ny_2_1.intro.4
      route: 
      replaces: 
    - speaker: agent_m
      text: "Je vois ce que chaque cam\xE9ra a film\xE9 hier. Coupons-les dans l'ordre : celles qui regardent la caisse en dernier."
      key: narration.ny_2_1.intro.4.m
      route: agent_m
      replaces: narration.ny_2_1.intro.4
    - speaker: commercant
      text: "Vous \xEAtes l'Aube. Faites vite, avant que quelqu'un le raconte."
      key: narration.ny_2_1.intro.5
      route: 
      replaces: 
    narrationAfter: []
