    narrationBefore:
    - speaker: enforcer
      text: "On ne coupe pas ce qui prot\xE8ge le quartier. Surtout pas pour des visiteurs."
      key: narration.ny_2_1.elite.before.0
      route: 
      replaces: 
    - speaker: ilona_varga
      text: "\xAB Prot\xE9ger \xBB : tu es s\xFBr que c'est le mot qu'ils t'ont donn\xE9 ?"
      key: narration.ny_2_1.elite.before.1
      route: 
      replaces: 
    narrationAfter:
    - speaker: lucas_mendes
      text: "Regardez le bo\xEEtier. Ce n'est pas un mod\xE8le de rue. Il y a un sigle grav\xE9 dessous."
      key: narration.ny_2_1.elite.after.0
      route: 
      replaces: 
    - speaker: giulia_rossi
      text: "Un prestataire de l'AMIF. Les cam\xE9ras du Syndicat sont lou\xE9es \xE0 l'agence."
      key: narration.ny_2_1.elite.after.1
      route: 
      replaces: 
