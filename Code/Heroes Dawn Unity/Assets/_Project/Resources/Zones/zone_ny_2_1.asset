    narrationAfter:
    - speaker: ilona_varga
      text: "Un gang qui loue ses yeux \xE0 une agence d'\xC9tat. On remonte la piste jusqu'\xE0 Astoria."
      key: narration.ny_2_1.exit.0
      route: 
      replaces: 
    - speaker: agent_d
      text: "Ou on suit les cam\xE9ras. Elles vont toutes dans la m\xEAme direction."
      key: narration.ny_2_1.exit.1
      route: 
      replaces: 
    - speaker: agent_m
      text: "\xC0 Moscou, c'\xE9taient des hologrammes. Ici, des cam\xE9ras. Le m\xEAme sourire poli derri\xE8re."
      key: narration.ny_2_1.exit.2
      route: agent_m
