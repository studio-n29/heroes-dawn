    narrationBefore:
    - speaker: enforcer
      text: "L'\xE9vacuation est suspendue. Le transfert ne s'arr\xEAte pas pour un accident."
      key: narration.mos_2_1.elite.before.0
      route: 
      replaces: 
    - speaker: ilona_varga
      text: Il parle de transfert avant de parler des ouvriers. Il vient de se trahir.
      key: narration.mos_2_1.elite.before.1
      route: 
      replaces: 
    narrationAfter:
    - speaker: ouvrier
      text: "On nous a dit de quitter le site pour la nuit. Quelques-uns ont refus\xE9."
      key: narration.mos_2_1.elite.after.0
      route: 
      replaces: 
    - speaker: agent_m
      text: "La fuite sert d'\xE9cran : pendant qu'on regarde les flammes, on charge autre chose."
      key: narration.mos_2_1.elite.after.1
      route: 
      replaces: 
