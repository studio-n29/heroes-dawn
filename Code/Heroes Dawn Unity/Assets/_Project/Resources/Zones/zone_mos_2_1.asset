    narrationBefore:
    - speaker: narrateur
      text: "Kapotnya respire un brouillard jaune. Les torch\xE8res \xE9clairent les tuyaux comme des cierges."
      key: narration.mos_2_1.intro.0
      route: 
      replaces: 
    - speaker: lucas_mendes
      text: "Alarme de gaz sur le bloc C. Il reste des gens \xE0 l'int\xE9rieur."
      key: narration.mos_2_1.intro.1
      route: 
      replaces: 
    - speaker: agent_m
      text: "La vanne \xE9tait ouverte avant l'alarme. Quelqu'un l'a tourn\xE9e \xE0 la main."
      key: narration.mos_2_1.intro.2
      route: 
      replaces: 
    - speaker: agent_d
      text: "Je vois la trace d'une main sur cette vanne. Quelqu'un l'a ouverte expr\xE8s."
      key: narration.mos_2_1.intro.2.d
      route: agent_d
      replaces: narration.mos_2_1.intro.2
    - speaker: giulia_rossi
      text: Pourquoi provoquer une fuite sur sa propre raffinerie ?
      key: narration.mos_2_1.intro.3
      route: 
      replaces: 
    - speaker: agent_m
      text: "Les torch\xE8res de la raffinerie\u2026 de loin, on dirait des cierges. Chez moi, tout br\xFBlait comme \xE7a."
      key: narration.mos_2_1.intro.4
      route: agent_m
      replaces: 
    narrationAfter: []
