    narrationBefore:
    - speaker: narrateur
      text: "Times Square ne dort jamais. Ce soir, chaque \xE9cran r\xE9p\xE8te le m\xEAme message : l'Aube est une menace."
      key: narration.ny_4_1.intro.0
      route: 
      replaces: 
    - speaker: voix
      text: "\xAB Les m\xE9ta-humains non encadr\xE9s mettent en danger les civils. L'AMIF vous prot\xE8ge. \xBB"
      key: narration.ny_4_1.intro.1
      route: 
      replaces: 
    - speaker: giulia_rossi
      text: "Ils ont repris les images de Brooklyn. \xC0 l'envers."
      key: narration.ny_4_1.intro.2
      route: 
      replaces: 
    - speaker: lucas_mendes
      text: "La r\xE9gie est au sous-sol. Si on y arrive, on peut remplacer le flux."
      key: narration.ny_4_1.intro.3
      route: 
      replaces: 
    - speaker: agent_d
      text: "On ne leur r\xE9pond pas avec des mots. On leur montre."
      key: narration.ny_4_1.intro.4
      route: 
      replaces: 
    - speaker: agent_m
      text: "Je vois ce que ces \xE9crans montreront dans une minute, si on les laisse faire. Rempla\xE7ons-le avant."
      key: narration.ny_4_1.intro.4.m
      route: agent_m
      replaces: narration.ny_4_1.intro.4
    narrationAfter: []
