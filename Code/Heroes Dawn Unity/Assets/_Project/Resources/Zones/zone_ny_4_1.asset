    narrationBefore:
    - speaker: agent_amif
      text: "Cette zone est sous contr\xF4le. Merci de reculer. Vous \xEAtes film\xE9s."
      key: narration.ny_4_1.elite.before.0
      route: 
      replaces: 
    - speaker: ilona_varga
      text: "Il ne dit pas \xAB interdit \xBB. Il dit \xAB film\xE9s \xBB. Il veut que \xE7a se voie."
      key: narration.ny_4_1.elite.before.1
      route: 
      replaces: 
    narrationAfter:
    - speaker: lucas_mendes
      text: "R\xE9gie atteinte. Le flux est \xE0 nous."
      key: narration.ny_4_1.elite.after.0
      route: 
      replaces: 
