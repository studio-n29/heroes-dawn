    x: 14
    y: 2
    activity: 
    hasCombat: 0
    enemyTable: []
    rounds: 1
    enemiesMin: 2
    enemiesMax: 3
    narrationBefore: []
    narrationAfter:
    - speaker: narrateur
      text: "Sur tous les \xE9crans, l'\xE9vacuation du bloc de Harlem : un enfant, des bras, une porte qui tient."
      key: narration.ny_4_1.exit.0
      route: 
      replaces: 
    - speaker: ilona_varga
      text: "Pas le registre, pas encore. Une preuve diffus\xE9e trop t\xF4t sera d\xE9mentie. Montrons d'abord ce qu'on est."
      key: narration.ny_4_1.exit.1
      route: 
      replaces: 
    - speaker: giulia_rossi
      text: "\xC7a suffit pour ce soir. Les gens ont regard\xE9."
      key: narration.ny_4_1.exit.2
      route: 
      replaces: 
    - speaker: agent_m
      text: "\xC0 Moscou, c'\xE9taient des hologrammes. Ici, des panneaux. La mise en sc\xE8ne est la m\xEAme."
      key: narration.ny_4_1.exit.3
      route: agent_m
      replaces: 
