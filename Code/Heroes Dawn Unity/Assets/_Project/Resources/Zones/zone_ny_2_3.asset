    narrationBefore:
    - speaker: enforcer
      text: Ce convoi est sous contrat. Reculez, ou le contrat vous inclura.
      key: narration.ny_2_3.elite.before.0
      route: 
      replaces: 
    - speaker: ilona_varga
      text: "Il r\xE9cite. Il ne sait m\xEAme pas pour qui il travaille."
      key: narration.ny_2_3.elite.before.1
      route: 
      replaces: 
    narrationAfter:
    - speaker: captif
      text: "Vous \xEAtes\u2026 de l'Aube ? On nous avait dit qu'on partait vers un endroit s\xFBr."
      key: narration.ny_2_3.elite.after.0
      route: 
      replaces: 
    - speaker: giulia_rossi
      text: Qui vous l'a dit ?
      key: narration.ny_2_3.elite.after.1
      route: 
      replaces: 
    - speaker: captif
      text: Un homme avec un badge. Il disait que l'agence se chargerait de nous.
      key: narration.ny_2_3.elite.after.2
      route: 
      replaces: 
