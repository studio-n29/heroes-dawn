    narrationBefore:
    - speaker: narrateur
      text: "La gare de triage de Jamaica dort sous les lampes orange. Un convoi sans marque attend \xE0 la voie 14."
      key: narration.ny_2_3.intro.0
      route: 
      replaces: 
    - speaker: lucas_mendes
      text: "Pas d'\xE9tiquette, pas de num\xE9ro, et une escorte arm\xE9e. Ce n'est pas du fret."
      key: narration.ny_2_3.intro.1
      route: 
      replaces: 
    - speaker: giulia_rossi
      text: Dans les wagons, il y a des gens. Je les entends respirer.
      key: narration.ny_2_3.intro.2
      route: 
      replaces: 
    - speaker: agent_d
      text: Alors on ne ralentit pas. On ouvre le dernier wagon.
      key: narration.ny_2_3.intro.3
      route: 
      replaces: 
    - speaker: agent_m
      text: "Je vois qui est mont\xE9 dans ces wagons, et ce qu'on leur a promis. On ne ralentit pas."
      key: narration.ny_2_3.intro.3.m
      route: agent_m
      replaces: narration.ny_2_3.intro.3
    narrationAfter: []
