    narrationBefore:
    - speaker: agent_amif
      text: "Le G\xE9n\xE9ral a demand\xE9 \xE0 vous parler. Seul \xE0 seul."
      key: narration.ny_4_4.elite.before.0
      route: 
      replaces: 
    - speaker: ilona_varga
      text: "\xAB Seul \xE0 seul \xBB devant mille cam\xE9ras."
      key: narration.ny_4_4.elite.before.1
      route: 
      replaces: 
    narrationAfter:
    - speaker: giulia_rossi
      text: "La garde est tomb\xE9e. Plus rien entre lui et nous."
      key: narration.ny_4_4.elite.after.0
      route: 
      replaces: 
