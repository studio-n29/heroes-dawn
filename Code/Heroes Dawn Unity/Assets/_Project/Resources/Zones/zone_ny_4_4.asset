    rounds: 1
    enemiesMin: 2
    enemiesMax: 3
    narrationBefore:
    - speaker: stroke
      text: "Je vous f\xE9licite. Vous avez tenu votre salle, repris vos \xE9crans, retourn\xE9 quelques indics. Il ne manque que la suite logique."
      key: narration.ny_4_4.boss.before.0
      route: 
      replaces: 
    - speaker: stroke
      text: "Inscrivez-vous. Volontairement. Je vous garantis votre rang, votre immunit\xE9, votre autonomie. L'Aube deviendrait une section de l'agence."
      key: narration.ny_4_4.boss.before.1
      route: 
      replaces: 
    - speaker: agent_d
      text: "Votre agence pr\xE9l\xE8ve ce qu'elle appelle prot\xE9ger. On a vu les wagons."
      key: narration.ny_4_4.boss.before.2
      route: 
      replaces: 
    - speaker: agent_m
      text: "\xC0 Paris, j'ai vu ce que vous pr\xE9levez. Des milliers de morts, vous dites ? Vous avez aussi gard\xE9 les restes."
      key: narration.ny_4_4.boss.before.2.m
      route: agent_m
      replaces: narration.ny_4_4.boss.before.2
    - speaker: stroke
      text: "Vous avez vu des wagons. J'ai vu des milliers de morts \xE0 Paris. Nous ne sommes pas d'accord sur la comptabilit\xE9."
      key: narration.ny_4_4.boss.before.3
      route: 
      replaces: 
    narrationAfter:
    - speaker: stroke
      text: "Vous croyez avoir gagn\xE9. L'esplanade vous regarde, mais c'est \xE0 Salem que tout se r\xE8gle."
      key: narration.ny_4_4.boss.after.0
      route: 
      replaces: 
    - speaker: ilona_varga
      text: Il se retire. Il n'a pas l'air vaincu.
      key: narration.ny_4_4.boss.after.1
      route: 
      replaces: 
    - speaker: stroke
      text: "Salem d\xE9cidera."
      key: narration.ny_4_4.boss.after.2
      route: 
      replaces: 
    - speaker: agent_d
      text: "Je ne sais pas ce qu'il pr\xE9pare \xE0 Salem. Mais il sait qu'on y sera."
      key: narration.ny_4_4.boss.after.3.d
      route: agent_d
      replaces: 
    - speaker: agent_m
      text: "Salem. L\xE0 o\xF9 Moscou et Paris se rejoignent. Il sait que j'y serai aussi."
      key: narration.ny_4_4.boss.after.3.m
      route: agent_m
      replaces: 
    - speaker: narrateur
      text: "Les Accords de Salem sortent au grand jour. Stroke s'est retir\xE9, mais sa promesse p\xE8se sur la ville."
      key: narration.ny_4_4.chapter_end.0
      route: 
      replaces: 
    - speaker: rayner
      text: "Les n\xE9gociations commencent \xE0 Salem. C'est l\xE0 que tout se jouera."
      key: narration.ny_4_4.chapter_end.1
      route: 
      replaces: 
