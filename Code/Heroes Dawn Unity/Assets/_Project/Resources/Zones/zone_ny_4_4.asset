    narrationBefore:
    - speaker: narrateur
      text: "L'esplanade de l'ONU est inond\xE9e de lumi\xE8re. Des cam\xE9ras de presse bordent le p\xE9rim\xE8tre. Au centre, un homme seul en uniforme gris."
      key: narration.ny_4_4.intro.0
      route: 
      replaces: 
    - speaker: lucas_mendes
      text: "Il n'a pas ses gardes de tout \xE0 l'heure. Il a voulu qu'on le voie seul."
      key: narration.ny_4_4.intro.1
      route: 
      replaces: 
