    - speaker: apex_libere
      text: Merci. Je croyais que personne ne viendrait.
      key: narration.mos_2_3.exit.0
      route: 
      replaces: 
    - speaker: agent_m
      text: "Les dossiers du laboratoire, avec le registre du monast\xE8re : le march\xE9 noir est prouv\xE9."
      key: narration.mos_2_3.exit.1
