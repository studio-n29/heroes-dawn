    narrationBefore:
    - speaker: narrateur
      text: "Sous l'entrep\xF4t frigorifique, un laboratoire. Les couloirs sont blancs, les tubes pleins d'une lumi\xE8re qui n'est pas de l'\xE9lectricit\xE9."
      key: narration.mos_2_3.intro.0
      route: 
      replaces: 
    - speaker: lucas_mendes
      text: "Je n'aime pas cette lumi\xE8re. Elle a la couleur de Paris."
      key: narration.mos_2_3.intro.1
      route: 
      replaces: 
    - speaker: apex_libere
      text: "Ne\u2026 ne me touchez pas. Ils m'ont d\xE9j\xE0 pris ce qui brillait en moi."
      key: narration.mos_2_3.intro.2
      route: 
      replaces: 
    - speaker: ilona_varga
      text: "Tu es en s\xE9curit\xE9. Respire. On te sort."
      key: narration.mos_2_3.intro.3
      route: 
      replaces: 
    - speaker: agent_m
      text: "L'odeur\u2026 cette cire br\xFBl\xE9e, ici ? Sous un laboratoire ?"
      key: narration.mos_2_3.intro.4
      route: agent_m
      replaces: 
    narrationAfter: []
