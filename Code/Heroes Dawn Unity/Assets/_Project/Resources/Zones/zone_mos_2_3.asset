    narrationBefore:
    - speaker: technicien
      text: "Les dossiers ne sortent pas. Je les d\xE9truirai plut\xF4t que de vous les laisser."
      key: narration.mos_2_3.elite.before.0
      route: 
      replaces: 
    - speaker: agent_m
      text: "Je vois ses mains avant qu'il ne bouge. Il va jeter les dossiers dans l'incin\xE9rateur."
      key: narration.mos_2_3.elite.before.1
      route: 
      replaces: 
    - speaker: agent_d
      text: Il n'a pas l'air d'un chimiste. Il a l'air d'un homme qui a peur de ceux qui lisent ces papiers.
      key: narration.mos_2_3.elite.before.1.d
      route: agent_d
      replaces: narration.mos_2_3.elite.before.1
    narrationAfter:
    - speaker: giulia_rossi
      text: Les dossiers sont intacts. Toutes les livraisons, tous les noms de clients.
      key: narration.mos_2_3.elite.after.0
      route: 
      replaces: 
    - speaker: lucas_mendes
      text: "Un client revient \xE0 chaque page : l'AMIF."
      key: narration.mos_2_3.elite.after.1
      route: 
      replaces: 
    - speaker: ilona_varga
      text: "Et dans les marges, des annotations sign\xE9es \xAB Volkov \xBB. Des chiffres d'avant l'Union."
      key: narration.mos_2_3.elite.after.2
      route: 
      replaces: 
