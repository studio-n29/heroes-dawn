    narrationBefore:
    - speaker: enforcer
      text: "Les archives sont ferm\xE9es au public."
      key: narration.mos_1_2.elite.before.0
      route: 
      replaces: 
    - speaker: agent_m
      text: Pas pour la restauratrice de la fresque.
      key: narration.mos_1_2.elite.before.1
      route: 
      replaces: 
    narrationAfter:
    - speaker: agent_m
      text: "Derri\xE8re la fresque, un registre. Je l'avais vu avant de le toucher."
      key: narration.mos_1_2.elite.after.0
      route: 
      replaces: 
    - speaker: lucas_mendes
      text: "Des noms\u2026 des dates\u2026 des livraisons. Ce sont des ventes."
      key: narration.mos_1_2.elite.after.1
      route: 
      replaces: 
