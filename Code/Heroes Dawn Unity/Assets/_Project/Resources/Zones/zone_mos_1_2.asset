    narrationBefore:
    - speaker: narrateur
      text: "Le monast\xE8re est silencieux. Les archives de Sergueiv dorment sous les vo\xFBtes, au bout d'un couloir de cierges."
      key: narration.mos_1_2.intro.0
      route: 
      replaces: 
    - speaker: lucas_mendes
      text: "Les cierges sont \xE9lectriques. M\xEAme les saints ont une facture d'\xE9nergie."
      key: narration.mos_1_2.intro.1
      route: 
      replaces: 
    - speaker: agent_m
      text: "Cette fresque a \xE9t\xE9 repeinte. Moins de dix jours. Le pigment ne ment pas."
      key: narration.mos_1_2.intro.2
      route: 
      replaces: 
    - speaker: agent_d
      text: "Je dessine des murs, pas des fresques. Mais celui-ci a \xE9t\xE9 retouch\xE9, j'en suis s\xFBr."
      key: narration.mos_1_2.intro.2.d
      route: agent_d
      replaces: narration.mos_1_2.intro.2
    - speaker: giulia_rossi
      text: Quelqu'un a pris la peine de peindre par-dessus un mur. Pour cacher quoi ?
      key: narration.mos_1_2.intro.3
      route: 
      replaces: 
    - speaker: agent_m
      text: "Je le vois\u2026 et je ne vois pas la couleur, je vois la porte."
      key: narration.mos_1_2.intro.4
      route: 
      replaces: 
    - speaker: agent_d
      text: Je vois le trait qui ne va pas. Je ne vois pas pourquoi.
      key: narration.mos_1_2.intro.4.d
      route: agent_d
      replaces: narration.mos_1_2.intro.4
    - speaker: agent_m
      text: "M\xEAme couloir de cierges que chez moi\u2026 avant que tout bascule."
      key: narration.mos_1_2.intro.5
      route: agent_m
      replaces: 
    narrationAfter: []
