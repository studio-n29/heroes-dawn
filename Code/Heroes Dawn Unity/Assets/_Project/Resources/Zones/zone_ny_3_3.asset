    narrationBefore:
    - speaker: narrateur
      text: "Les vendeurs du march\xE9 montent leurs b\xE2ches avant le jour. \xC0 deux rues, la clinique s'allume."
      key: narration.ny_3_3.intro.0
      route: 
      replaces: 
    - speaker: commercant
      text: "Ici, tout le monde se conna\xEEt. Si le march\xE9 tombe, les gens n'ont plus rien \xE0 manger."
      key: narration.ny_3_3.intro.1
      route: 
      replaces: 
    - speaker: lucas_mendes
      text: "Deux alertes en m\xEAme temps. Le gang attaque la clinique et le march\xE9."
      key: narration.ny_3_3.intro.2
      route: 
      replaces: 
    - speaker: giulia_rossi
      text: On ne peut pas couvrir les deux. Pas assez de monde.
      key: narration.ny_3_3.intro.3
      route: 
      replaces: 
