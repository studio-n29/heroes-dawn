    narrationBefore:
    - speaker: narrateur
      text: "La salle est tamis\xE9e. Des ench\xE9risseurs masqu\xE9s l\xE8vent un doigt, jamais la voix."
      key: narration.mos_3_2.intro.0
      route: 
      replaces: 
    - speaker: commissaire
      text: "Mesdames, messieurs, le lot suivant : un Apex \xE9veill\xE9, de rang cinq, en excellent \xE9tat."
      key: narration.mos_3_2.intro.1
      route: 
      replaces: 
    - speaker: giulia_rossi
      text: "Un lot. Ils disent \xAB lot \xBB."
      key: narration.mos_3_2.intro.2
      route: 
      replaces: 
    - speaker: agent_m
      text: "Je vois l'homme qu'ils pr\xE9sentent, sa vie avant la vente. On le vend avec son pass\xE9."
      key: narration.mos_3_2.intro.3
      route: 
      replaces: 
    - speaker: agent_d
      text: Je dessinerais bien un barreau devant chaque lot. Mais ce n'est pas encore le moment.
      key: narration.mos_3_2.intro.3.d
      route: agent_d
      replaces: narration.mos_3_2.intro.3
