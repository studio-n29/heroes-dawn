    narrationBefore:
    - speaker: narrateur
      text: "Astoria, une heure du matin. Le caf\xE9 est \xE0 moiti\xE9 ferm\xE9, la salle \xE0 moiti\xE9 pleine. Tous parlent \xE0 voix basse."
      key: narration.ny_2_2.intro.0
      route: 
      replaces: 
    - speaker: lucas_mendes
      text: "Celui du fond n'a pas touch\xE9 son caf\xE9. Il regarde la porte toutes les trente secondes."
      key: narration.ny_2_2.intro.1
      route: 
      replaces: 
    - speaker: indic
      text: Je ne suis pas une balance. Je suis un type qui a une fille.
      key: narration.ny_2_2.intro.2
      route: 
      replaces: 
    - speaker: agent_d
      text: On ne vous demande pas de trahir. On vous demande de dire ce qu'on ne peut plus ignorer.
      key: narration.ny_2_2.intro.3
      route: 
      replaces: 
    - speaker: agent_m
      text: "Je vois ce qui t'est arriv\xE9 ce matin. On ne te demande pas de parler : on te demande de nous laisser \xE9couter."
      key: narration.ny_2_2.intro.3.m
      route: agent_m
      replaces: narration.ny_2_2.intro.3
    - speaker: ilona_varga
      text: Il ne ment pas. Il a peur pour quelqu'un, pas pour lui.
      key: narration.ny_2_2.intro.4
      route: 
      replaces: 
    narrationAfter: []
