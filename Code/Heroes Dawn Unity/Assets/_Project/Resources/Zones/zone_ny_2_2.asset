    enemiesMin: 2
    enemiesMax: 3
    narrationBefore: []
    narrationAfter:
    - speaker: indic
      text: Chaque jeudi, le Syndicat apporte une liste. Des noms, des quartiers, des pouvoirs. Un type en costume la prend, sans jamais donner son nom.
      key: narration.ny_2_2.exit.0
      route: 
      replaces: 
    - speaker: giulia_rossi
      text: Un costume de l'AMIF ?
      key: narration.ny_2_2.exit.1
      route: 
      replaces: 
    - speaker: indic
      text: "Un costume qui ne se salit jamais. Les nouveaux Apex apparaissent sur la liste avant m\xEAme d'avoir peur."
      key: narration.ny_2_2.exit.2
      route: 
      replaces: 
    - speaker: ilona_varga
      text: "On t'emm\xE8ne dans un refuge. Ta fille aussi."
      key: narration.ny_2_2.exit.3
      route: 
      replaces: 
    - speaker: agent_m
      text: "\xC0 Moscou, on parle de clients. Ici, de listes. C'est le m\xEAme mot."
      key: narration.ny_2_2.exit.4
      route: agent_m
      replaces: 
