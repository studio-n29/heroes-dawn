    narrationBefore:
    - speaker: enforcer
      text: "Tout le monde reste assis. Il y a des visiteurs qui n'ont pas \xE9t\xE9 invit\xE9s."
      key: narration.ny_2_2.elite.before.0
      route: 
      replaces: 
    narrationAfter:
    - speaker: giulia_rossi
      text: Dehors, vite. Avant que les autres comprennent.
      key: narration.ny_2_2.elite.after.0
      route: 
