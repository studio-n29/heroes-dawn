    narrationBefore:
    - speaker: agent_amif
      text: "Pour la s\xE9curit\xE9 des d\xE9l\xE9gu\xE9s, la salle est \xE9vacu\xE9e. Merci de coop\xE9rer."
      key: narration.ny_4_3.elite.before.0
      route: 
      replaces: 
    - speaker: ilona_varga
      text: "\xC9vacuer la salle, c'est \xE9touffer l'annonce. Il le sait."
      key: narration.ny_4_3.elite.before.1
      route: 
      replaces: 
    narrationAfter:
    - speaker: giulia_rossi
      text: La salle est tenue. Rayner peut parler.
      key: narration.ny_4_3.elite.after.0
      route: 
      replaces: 
  - id: n15
    type: 5
    isFixed: 0
    rank: 1
    x: 7
    y: 4
    activity: 
    hasCombat: 0
    enemyTable: []
    rounds: 1
    enemiesMin: 2
    enemiesMax: 3
    narrationBefore: []
    narrationAfter: []
  - id: n16
    type: 4
    isFixed: 0
    rank: 1
    x: 8
    y: 4
    activity: 
    hasCombat: 0
    enemyTable: []
    rounds: 1
    enemiesMin: 2
    enemiesMax: 3
    narrationBefore: []
    narrationAfter: []
  - id: n17
    type: 1
    isFixed: 1
    rank: 1
    x: 9
    y: 3
    activity: 
    hasCombat: 0
    enemyTable: []
    rounds: 1
    enemiesMin: 2
    enemiesMax: 3
    narrationBefore: []
    narrationAfter:
    - speaker: rayner
      text: "Les Apex ne demandent pas la permission d'exister. Ils demandent d'\xEAtre reconnus, pas contr\xF4l\xE9s."
      key: narration.ny_4_3.stage.0
      route: 
      replaces: 
    - speaker: stroke
      text: "Madame Rayner parle de reconnaissance. Je parle de responsabilit\xE9. Un pouvoir qu'on ne mesure pas est un pouvoir qu'on ne prot\xE8ge pas."
      key: narration.ny_4_3.stage.1
      route: 
      replaces: 
    - speaker: rayner
      text: "Mesurer, pr\xE9lever, enfermer : ce n'est pas prot\xE9ger. C'est poss\xE9der."
      key: narration.ny_4_3.stage.2
      route: 
      replaces: 
    - speaker: stroke
      text: "Les chiffres de Paris, madame, ne mentent pas. Je ne poss\xE8de personne. Je compte."
      key: narration.ny_4_3.stage.3
      route: 
      replaces: 
    - speaker: rayner
      text: "Alors comptez aussi ceux que vous avez enferm\xE9s \xE0 Queens. Il y en avait beaucoup."
      key: narration.ny_4_3.stage.4
      route: 
      replaces: 
    - speaker: agent_d
      text: "C'est lui. Il n'a pas de visage m\xE9chant. C'est ce qui est le plus effrayant."
      key: narration.ny_4_3.stage.5.d
      route: agent_d
      replaces: 
    - speaker: agent_m
      text: "Les chiffres de Paris. J'y \xE9tais. Ils n'ont pas dit tout ce qu'ils ont compt\xE9."
      key: narration.ny_4_3.stage.5.m
      route: agent_m
      replaces: 
