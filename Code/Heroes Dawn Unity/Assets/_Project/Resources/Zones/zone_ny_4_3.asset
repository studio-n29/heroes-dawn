    narrationBefore:
    - speaker: narrateur
      text: "Le hall de l'ONU est plein de drapeaux, de micros et de regards. Dans une heure, les Accords de Salem seront annonc\xE9s."
      key: narration.ny_4_3.intro.0
      route: 
      replaces: 
    - speaker: giulia_rossi
      text: "Quelqu'un coupe d\xE9j\xE0 les c\xE2bles de la retransmission."
      key: narration.ny_4_3.intro.1
      route: 
      replaces: 
    - speaker: lucas_mendes
      text: "Sabotage \xE0 l'\xE9tage technique. Si l'annonce ne passe pas, tout \xE7a n'a servi \xE0 rien."
      key: narration.ny_4_3.intro.2
      route: 
      replaces: 
    - speaker: agent_d
      text: On tient la salle. Personne ne coupe cette retransmission.
      key: narration.ny_4_3.intro.3
      route: 
      replaces: 
    - speaker: agent_m
      text: "Je vois les mains qui couperont les c\xE2bles dans dix secondes. Je les arr\xEAte avant."
      key: narration.ny_4_3.intro.3.m
      route: agent_m
      replaces: narration.ny_4_3.intro.3
    narrationAfter: []
