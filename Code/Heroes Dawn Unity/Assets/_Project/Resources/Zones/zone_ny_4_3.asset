    x: 13
    y: 3
    activity: 
    hasCombat: 0
    enemyTable: []
    rounds: 1
    enemiesMin: 2
    enemiesMax: 3
    narrationBefore: []
    narrationAfter:
    - speaker: narrateur
      text: "La salle retient son souffle. Pour la premi\xE8re fois, la voix de l'AMIF et celle de The Dawn s'opposent devant tous."
      key: narration.ny_4_3.exit.0
      route: 
      replaces: 
    - speaker: ilona_varga
      text: "Il a gard\xE9 son calme. Il en gardera encore. Il nous attend dehors."
      key: narration.ny_4_3.exit.1
      route: 
      replaces: 
