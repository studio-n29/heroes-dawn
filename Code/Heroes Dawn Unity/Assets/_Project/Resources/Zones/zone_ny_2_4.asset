    narrationBefore:
    - speaker: narrateur
      text: "Le terminal de fret domine la baie. Au sommet d'une grue, une salle vitr\xE9e surveille chaque conteneur."
      key: narration.ny_2_4.intro.0
      route: 
      replaces: 
    - speaker: lucas_mendes
      text: "De l\xE0-haut, on voit tout. C'est exactement ce que veut un gestionnaire."
      key: narration.ny_2_4.intro.1
      route: 
      replaces: 
    - speaker: giulia_rossi
      text: "Des livraisons, des horaires, des num\xE9ros\u2026 et \xE0 c\xF4t\xE9, le m\xEAme sigle que sur les cam\xE9ras."
      key: narration.ny_2_4.intro.2
      route: 
      replaces: 
    - speaker: agent_d
      text: On ne prend pas des extraits. On prend le registre entier.
      key: narration.ny_2_4.intro.3
      route: 
      replaces: 
