    narrationBefore:
    - speaker: enforcer
      text: "La direction ne re\xE7oit pas sans rendez-vous."
      key: narration.ny_2_4.elite.before.0
      route: 
      replaces: 
    narrationAfter:
    - speaker: ilona_varga
      text: "Il n'y a plus que lui l\xE0-haut. Et il nous attend."
      key: narration.ny_2_4.elite.after.0
      route: 
