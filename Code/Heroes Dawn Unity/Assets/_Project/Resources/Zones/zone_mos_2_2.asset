      replaces: 
    - speaker: lucas_mendes
      text: "Autoris\xE9 par qui ? Il ne r\xE9pond pas."
      key: narration.mos_2_2.elite.before.1
      route: 
      replaces: 
    narrationAfter:
    - speaker: giulia_rossi
      text: "Les caisses brillent. Ce sont des r\xE9sidus de la Supernova."
      key: narration.mos_2_2.elite.after.0
      route: 
      replaces: 
