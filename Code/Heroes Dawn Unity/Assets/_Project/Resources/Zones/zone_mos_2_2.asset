    narrationBefore:
    - speaker: narrateur
      text: La route du convoi traverse la brume. Les camions roulent sans phares, comme s'ils connaissaient chaque virage.
      key: narration.mos_2_2.intro.0
      route: 
      replaces: 
    - speaker: giulia_rossi
      text: "Quatre camions, une escorte, et pas un seul feu allum\xE9."
      key: narration.mos_2_2.intro.1
      route: 
      replaces: 
    - speaker: agent_m
      text: "Les camions sont charg\xE9s de ce que nous avons vu sur la voie 9. Mais plus lourd, plus dangereux."
      key: narration.mos_2_2.intro.2
      route: 
      replaces: 
    - speaker: agent_d
      text: "Ces caisses ont \xE9t\xE9 emball\xE9es par des mains qui savent ce qu'elles portent."
      key: narration.mos_2_2.intro.2.d
      route: agent_d
      replaces: narration.mos_2_2.intro.2
