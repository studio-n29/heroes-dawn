    narrationBefore:
    - speaker: contremaitre
      text: "Gromov, chef de quai. Vous \xEAtes en retard : le dernier camion est d\xE9j\xE0 parti."
      key: narration.mos_2_4.boss.before.0
      route: 
      replaces: 
    - speaker: contremaitre
      text: "Je ne pose pas de questions. Je v\xE9rifie les bordereaux et je signe. C'est pour cela qu'on me paie."
      key: narration.mos_2_4.boss.before.1
      route: 
      replaces: 
    - speaker: agent_m
      text: Par qui ?
      key: narration.mos_2_4.boss.before.2
      route: 
      replaces: 
    - speaker: agent_d
      text: "Qui signe vos ch\xE8ques ?"
      key: narration.mos_2_4.boss.before.2.d
      route: agent_d
      replaces: narration.mos_2_4.boss.before.2
    - speaker: contremaitre
      text: "Un chef de quai ne r\xE9pond pas \xE0 cette question. Un chef de quai p\xE8se, compte, exp\xE9die."
      key: narration.mos_2_4.boss.before.3
      route: 
      replaces: 
    narrationAfter:
    - speaker: contremaitre
      text: 'Assez. Je ne suis qu''un chef de quai : je compte, je charge, je signe.'
      key: narration.mos_2_4.boss.after.0
      route: 
      replaces: 
    - speaker: contremaitre
      text: Orlan paie.
      key: narration.mos_2_4.boss.after.1
      route: 
      replaces: 
    - speaker: agent_m
      text: Orlan.
      key: narration.mos_2_4.boss.after.2
      route: 
      replaces: 
    - speaker: contremaitre
      text: "La cire sur les caisses ? Une habitude des hommes qui nous les confient. Une habitude d'\xE9glise."
      key: narration.mos_2_4.boss.after.3
      route: agent_m
      replaces: 
    - speaker: narrateur
      text: "L'Aube sait d\xE9sormais pour qui travaillent les camions. Le nom d'Orlan m\xE8ne aux tours de Sadovoye Koltso."
      key: narration.mos_2_4.chapter_end.0
      route: 
      replaces: 
