    - speaker: agent_m
      text: "C'est la lumi\xE8re qu'on a prise \xE0 l'Apex du laboratoire. Je la reconnais."
      key: narration.mos_3_1.exit.0
      route: 
      replaces: 
    - speaker: ilona_varga
      text: "Ils l'exposent comme un tableau. On monte aux ench\xE8res."
