    narrationBefore:
    - speaker: narrateur
      text: "Les tours de verre se refl\xE8tent dans le Jardin. \xC0 l'int\xE9rieur, des couloirs silencieux, des ascenseurs sans bruit."
      key: narration.mos_3_1.intro.0
      route: 
      replaces: 
    - speaker: giulia_rossi
      text: "Tout est trop propre. M\xEAme le silence a \xE9t\xE9 nettoy\xE9."
      key: narration.mos_3_1.intro.1
      route: 
      replaces: 
    - speaker: lucas_mendes
      text: "Ce salon\u2026 il y a des bocaux. Avec de la lumi\xE8re dedans."
      key: narration.mos_3_1.intro.2
      route: 
      replaces: 
    - speaker: agent_m
      text: "Ce ne sont pas des bocaux. Ce sont des troph\xE9es."
      key: narration.mos_3_1.intro.3
      route: 
      replaces: 
    - speaker: agent_d
      text: "On expose des gens comme on expose des tableaux. Quelqu'un en tire de la fiert\xE9."
      key: narration.mos_3_1.intro.3.d
      route: agent_d
      replaces: narration.mos_3_1.intro.3
