    narrationBefore:
    - speaker: passeur
      text: "Vous \xEAtes en avance. D'ordinaire mes clients prennent rendez-vous."
      key: narration.mos_1_4.boss.before.0
      route: 
      replaces: 
    - speaker: passeur
      text: 'Je ne dis pas victimes. Je ne dis pas adversaires. Je dis : clients.'
      key: narration.mos_1_4.boss.before.1
      route: 
      replaces: 
    - speaker: ilona_varga
      text: "N'\xE9coute pas. Il compte d\xE9j\xE0 ce qu'il peut vendre de nous."
      key: narration.mos_1_4.boss.before.2
      route: 
      replaces: 
    - speaker: passeur
      text: "Les pouvoirs ont un prix, mademoiselle Varga. Les v\xF4tres aussi."
      key: narration.mos_1_4.boss.before.3
      route: 
      replaces: 
    - speaker: passeur
      text: "Votre vue sur le pass\xE9 vaut cher, mademoiselle. Les ench\xE8res sont ouvertes."
      key: narration.mos_1_4.boss.before.3.m
      route: agent_m
      replaces: narration.mos_1_4.boss.before.3
    - speaker: passeur
      text: "Une imagination qui devient mati\xE8re. Voil\xE0 un produit que je n'ai jamais eu en rayon."
      key: narration.mos_1_4.boss.before.3.d
      route: agent_d
      replaces: narration.mos_1_4.boss.before.3
    narrationAfter:
    - speaker: passeur
      text: "Vous croyez avoir trouv\xE9 quelque chose ? On vous a laiss\xE9 trouver. L'accueil, c'est moi qui l'ai organis\xE9."
      key: narration.mos_1_4.boss.after.0
      route: 
      replaces: 
    - speaker: agent_m
      text: "Alors c'\xE9tait pour nous tenir loin de Kapotnya."
      key: narration.mos_1_4.boss.after.1
      route: 
      replaces: 
    - speaker: passeur
      text: "Je n'ai jamais dit \xAB loin \xBB. J'ai dit \xAB accueillis \xBB."
      key: narration.mos_1_4.boss.after.2
      route: 
      replaces: 
    - speaker: ilona_varga
      text: "Alors c'est l\xE0 que nous irons."
      key: narration.mos_1_4.boss.after.3
      route: 
      replaces: 
    - speaker: passeur
      text: "La cire, l'encens, les cierges\u2026 c'est un parfum qui revient souvent chez mes clients."
      key: narration.mos_1_4.boss.after.4
      route: agent_m
      replaces: 
    - speaker: narrateur
      text: "La Dawn comprend que l'accueil visait \xE0 la tenir loin de Kapotnya. Le convoi suivant part \xE0 l'aube."
      key: narration.mos_1_4.chapter_end.0
      route: 
      replaces: 
