    narrationBefore:
    - speaker: passeur
      text: "\xAB Vous \xEAtes en avance. D'ordinaire mes clients prennent rendez-vous. \xBB"
    - speaker: passeur
      text: "\xAB Je ne dis pas victimes. Je ne dis pas adversaires. Je dis : clients. \xBB"
    - speaker: ilona_varga
      text: "\xAB N'\xE9coute pas. Il compte d\xE9j\xE0 ce qu'il peut vendre de nous. \xBB"
    narrationAfter:
    - speaker: passeur
      text: "\xAB Vous croyez avoir trouv\xE9 quelque chose ? On vous a laiss\xE9 trouver. L'accueil, c'est moi qui l'ai organis\xE9. \xBB"
    - speaker: agent_m
      text: "\xAB Alors c'\xE9tait pour nous tenir loin de Kapotnya. \xBB"
    - speaker: ilona_varga
      text: "\xAB Alors c'est l\xE0 que nous irons. \xBB"
