    narrationBefore:
    - speaker: enforcer
      text: "Le d\xE9p\xF4t n'est pas ouvert. Vous avez d\xFB vous tromper de guichet."
      key: narration.mos_1_4.elite.before.0
      route: 
      replaces: 
    narrationAfter:
    - speaker: ilona_varga
      text: "Il n'avait pas peur de nous. Il avait peur de celui qui est derri\xE8re."
      key: narration.mos_1_4.elite.after.0
      route: 
      replaces: 
