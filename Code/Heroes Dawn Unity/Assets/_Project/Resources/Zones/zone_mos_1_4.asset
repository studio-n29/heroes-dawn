    narrationBefore:
    - speaker: narrateur
      text: "Le d\xE9p\xF4t est rang\xE9 comme une boutique. Chaque caisse porte une \xE9tiquette, chaque \xE9tiquette un prix."
      key: narration.mos_1_4.intro.0
      route: 
      replaces: 
    - speaker: giulia_rossi
      text: "Un entrep\xF4t de contrebande avec un syst\xE8me de rangement plus propre que le mien."
      key: narration.mos_1_4.intro.1
      route: 
      replaces: 
    - speaker: agent_m
      text: 'Ces caisses partent ce soir. Je vois le camion, le chemin, l''adresse : une raffinerie.'
      key: narration.mos_1_4.intro.2
      route: 
      replaces: 
    - speaker: lucas_mendes
      text: Donc tout converge vers Kapotnya.
      key: narration.mos_1_4.intro.3
      route: 
      replaces: 
