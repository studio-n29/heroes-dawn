    narrationBefore:
    - speaker: orlan
      text: "Bienvenue. Vous avez vu mes troph\xE9es, mes ench\xE8res, mes cam\xE9ras. Je suis honor\xE9 de votre curiosit\xE9."
      key: narration.mos_3_4.boss.before.0
      route: 
      replaces: 
    - speaker: orlan
      text: "Moscou vous a accueillis, mademoiselle. Je n'ai fait que vous offrir un spectacle \xE0 la hauteur."
      key: narration.mos_3_4.boss.before.1
      route: 
      replaces: 
    - speaker: orlan
      text: Moscou vous a accueillis, monsieur.
      key: narration.mos_3_4.boss.before.1.d
      route: agent_d
      replaces: narration.mos_3_4.boss.before.1
    - speaker: agent_m
      text: Des gens ne sont pas un spectacle.
      key: narration.mos_3_4.boss.before.2
      route: 
      replaces: 
    - speaker: agent_d
      text: Des gens ne sont pas un spectacle.
      key: narration.mos_3_4.boss.before.2.d
      route: agent_d
      replaces: narration.mos_3_4.boss.before.2
    - speaker: orlan
      text: Tout est un spectacle, mademoiselle. La seule question est de savoir qui tient la salle.
      key: narration.mos_3_4.boss.before.3
      route: 
      replaces: 
    narrationAfter:
    - speaker: orlan
      text: "Vous croyez m'avoir d\xE9masqu\xE9. Je ne suis qu'un ex\xE9cutant, comme tant d'autres."
      key: narration.mos_3_4.boss.after.0
      route: 
      replaces: 
    - speaker: agent_m
      text: Pour qui ?
      key: narration.mos_3_4.boss.after.1
      route: 
      replaces: 
    - speaker: orlan
      text: Pour quelqu'un au-dessus. Quelqu'un qui n'a jamais eu besoin de signer.
      key: narration.mos_3_4.boss.after.2
      route: 
      replaces: 
    - speaker: orlan
      text: Quelqu'un qui aime l'encens et la cire. Un homme d'ordre, mademoiselle.
      key: narration.mos_3_4.boss.after.3
      route: agent_m
      replaces: 
    - speaker: narrateur
      text: "La fausse vid\xE9o est d\xE9mentie, mais la rumeur circule. Orlan a avou\xE9 : quelqu'un tire encore les ficelles, plus haut."
      key: narration.mos_3_4.chapter_end.0
      route: 
      replaces: 
