    - speaker: giulia_rossi
      text: "Un mot revient sur les dossiers : \xAB Khost \xBB."
      key: narration.mos_4_2.exit.0
      route: 
      replaces: 
    - speaker: ilona_varga
      text: Je ne sais pas ce que c'est, mais ces dossiers parlent d'un endroit loin d'ici. Salem.
      key: narration.mos_4_2.exit.1
      route: 
      replaces: 
    - speaker: agent_m
      text: "Alors tout \xE7a, c'est le d\xE9but d'autre chose."
      key: narration.mos_4_2.exit.2
