    narrationBefore:
    - speaker: narrateur
      text: "Sous le Kremlin, les tunnels sentent la pierre mouill\xE9e et la cire. Des c\xE2bles anciens courent le long des murs."
      key: narration.mos_4_2.intro.0
      route: 
      replaces: 
    - speaker: lucas_mendes
      text: Ces tunnels datent d'avant l'Union. Quelqu'un les entretient.
      key: narration.mos_4_2.intro.1
      route: 
      replaces: 
    - speaker: giulia_rossi
      text: "Des salles de recherche. Des cages. Des planches d'anatomie\u2026 Des Apex, avant m\xEAme que le mot existe."
      key: narration.mos_4_2.intro.2
      route: 
      replaces: 
    - speaker: agent_m
      text: "Je vois les mains qui ont travaill\xE9 ici. Elles \xE9crivent comme dans les marges du laboratoire."
      key: narration.mos_4_2.intro.3
      route: 
      replaces: 
    - speaker: agent_d
      text: "Ces cages ont la taille d'un homme. Je pr\xE9f\xE8re ne pas dessiner ce qu'il y avait dedans."
      key: narration.mos_4_2.intro.3.d
      route: agent_d
      replaces: narration.mos_4_2.intro.3
    - speaker: agent_m
      text: "Cette odeur\u2026 cire, encens, pierre froide. C'est celle de la cath\xE9drale, avant l'explosion. Je ne comprends pas."
      key: narration.mos_4_2.intro.4
      route: agent_m
      replaces: 
    narrationAfter: []
