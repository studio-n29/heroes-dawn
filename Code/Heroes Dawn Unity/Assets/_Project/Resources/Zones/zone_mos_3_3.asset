    narrationBefore:
    - speaker: narrateur
      text: Le studio est un plateau noir. Des projecteurs dessinent des visages qui n'existent pas.
      key: narration.mos_3_3.intro.0
      route: 
      replaces: 
    - speaker: technicien_holo
      text: "Dans une heure, la ville verra l'Aube frapper des civils. Elle aura tout vu, et rien v\xE9cu."
      key: narration.mos_3_3.intro.1
      route: 
      replaces: 
    - speaker: lucas_mendes
      text: "Ils ont copi\xE9 nos silhouettes, nos insignes, nos mouvements."
      key: narration.mos_3_3.intro.2
      route: 
      replaces: 
    - speaker: agent_m
      text: "Je vois la vid\xE9o avant qu'elle n'existe. Quelqu'un l'a r\xE9p\xE9t\xE9e cent fois."
      key: narration.mos_3_3.intro.3
      route: 
      replaces: 
    - speaker: agent_d
      text: "Ils ont copi\xE9 mes lignes, mes couleurs, mes habitudes. M\xEAme mes erreurs. Quelqu'un \xE9tudie."
      key: narration.mos_3_3.intro.3.d
      route: agent_d
      replaces: narration.mos_3_3.intro.3
    narrationAfter: []
