    narrationBefore: []
    narrationAfter:
    - speaker: giulia_rossi
      text: Ceux qui paient l'AMIF paient aussi le Syndicat. Ce n'est pas une collusion, c'est un budget commun.
      key: narration.ny_4_2.exit.0
      route: 
      replaces: 
    - speaker: ilona_varga
      text: "Et l\xE0 : une fondation dont le nom me dit quelque chose. Des archives des ann\xE9es 80."
      key: narration.ny_4_2.exit.1
      route: 
      replaces: 
    - speaker: agent_d
      text: Pas ce soir. Mais on garde le nom.
      key: narration.ny_4_2.exit.2
      route: 
      replaces: 
    - speaker: agent_m
      text: "Orlan, le Passeur, ces financeurs\u2026 Ce sont les m\xEAmes personnes, en plus polies."
      key: narration.ny_4_2.exit.3
      route: agent_m
      replaces: 
