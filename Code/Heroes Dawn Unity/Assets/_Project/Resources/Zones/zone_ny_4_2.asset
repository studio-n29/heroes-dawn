    narrationBefore:
    - speaker: narrateur
      text: "La tour de verre domine Midtown. Au quarante-deuxi\xE8me \xE9tage, un gala r\xE9unit des fondations, des conseils, des sourires bien pay\xE9s."
      key: narration.ny_4_2.intro.0
      route: 
      replaces: 
    - speaker: giulia_rossi
      text: "On est les seuls \xE0 ne pas porter de badge dor\xE9."
      key: narration.ny_4_2.intro.1
      route: 
      replaces: 
    - speaker: lucas_mendes
      text: "Une salle de \xAB partenaires \xBB. Les noms sont affich\xE9s comme des troph\xE9es."
      key: narration.ny_4_2.intro.2
      route: 
      replaces: 
    - speaker: agent_d
      text: On ne vole rien. On compare.
      key: narration.ny_4_2.intro.3
      route: 
      replaces: 
    - speaker: agent_m
      text: "Je vois qui a sign\xE9 ces noms, et dans quel ordre. On ne vole rien : on lit."
      key: narration.ny_4_2.intro.3.m
      route: agent_m
      replaces: narration.ny_4_2.intro.3
