    narrationBefore:
    - speaker: enforcer
      text: "Cette salle est r\xE9serv\xE9e. Veuillez rejoindre le salon."
      key: narration.ny_4_2.elite.before.0
      route: 
      replaces: 
    - speaker: ilona_varga
      text: "Il a l'air poli. Il est tr\xE8s inquiet."
      key: narration.ny_4_2.elite.before.1
      route: 
      replaces: 
    narrationAfter:
    - speaker: giulia_rossi
      text: J'ai la liste de l'AMIF. Toi, celle du registre de Queens.
      key: narration.ny_4_2.elite.after.0
      route: 
      replaces: 
    - speaker: lucas_mendes
      text: Trois noms. Quatre. Cinq. Ils sont sur les deux.
      key: narration.ny_4_2.elite.after.1
      route: 
      replaces: 
