/* Heroes Dawn : ajustements de fidélité « planches » pour la zone shell. Importé après hd.uss : ces règles priment à spécificité égale. */

/* ================================================================================================================
   AIDE-MÉMOIRE DES CLASSES COMMUNES (définies dans hd.uss, sections communes ; utilisables par toutes les zones)

   Icônes ........ « hd-icon » (carré 40 px, image ajustée) + taille « hd-icon--xs » 20, « --sm » 28, « --md » 40, « --lg » 56, « --xl » 72
                   + glyphe blanc du kit : « hd-icon--back », « --forward », « --up », « --down », « --plus », « --minus », « --check »,
                     « --close », « --lock », « --settings », « --info », « --warning », « --error », « --gift », « --clock », « --dice »,
                     « --document », « --filter », « --health », « --attack », « --defense », « --speed », « --fatigue », « --energy », « --heal »
                   + teinte : « hd-icon--tint-ivory », « --tint-brass », « --tint-ink », « --tint-muted », « --tint-danger », « --tint-success »
                   Glyphes déjà colorés (sans teinte) : « hd-icon--star » (étoile laiton), « hd-icon--credits », « --pr », « --gems » (traits colorés),
                     « hd-icon--qg », « --team », « --pass », « --shop », « --profile », « --quest » (laiton).
                   Exemple : <ui:VisualElement class="hd-icon hd-icon--sm hd-icon--lock hd-icon--tint-muted" />
   Case à cocher . « hd-check » (vide) + « hd-check--on » (cochée) ; « hd-check--sm » 30 px. Remplace « [ ] » et « [x] ».
   Monnaie ....... « hd-coin » + « hd-coin--credits » | « --pr » | « --gems » (disque coloré, glyphe sombre) ; « hd-coin--sm » 30 px.
                   Pastille de portefeuille complète : <VisualElement class="hd-pill hd-wallet__pill hd-wallet__pill--credits">
                     <VisualElement class="hd-wallet__unit" /><Label class="hd-wallet__value" /></VisualElement>
                   (un ancien Label « CR » de classe « hd-wallet__unit » devient la pièce sans changer le modèle : son texte n'est plus affiché).
   Niveau ........ « hd-level » sur un Label (plaque ivoire à coin coupé, chiffres sombres) ; « hd-level--sm ».
   Notification .. « hd-dot » (point rouge 16 px) ; pastille chiffrée existante : « hd-badge » (absolue, coin haut droit du parent).
   Portrait ...... <VisualElement class="hd-portrait-frame [hd-portrait-frame--sm|--lg] [--enemy|--boss|--selected|--empty|--matter|--elemental|--physical-bio|--perception]">
                     <VisualElement class="hd-portrait-frame__art" />   (illustration « -head » posée en C# par style.backgroundImage)
                     <VisualElement class="hd-portrait-frame__ring" /></VisualElement>
   Boutons ....... « hd-btn--primary » reçoit seul son étoile (à gauche du libellé) et son chevron (à droite) : HdButtonDeco (C#) les pose
                   sur tout bouton principal non « hd-btn--small ». Ajouter « hd-btn--plain » pour les refuser (bascule, filtre, rangée sélectionnée).
                   « hd-btn--icon » : bouton carré à icône seule (enfant « hd-icon »). « hd-btn--lead » + enfant « hd-btn__lead hd-icon--back » :
                   bouton précédé d'un chevron (retour).
   Fenêtres ...... « hd-modal__title » porte l'étoile et se centre seul ; « hd-divider » juste dessous = filet ; « hd-modal__body » = encart mat ;
                   « hd-modal__buttons » : secondaire à gauche, principal à droite.
   ================================================================================================================ */

/* ---------------------------------------------------------------- Tutoriel : bulle de Rayner */
/* Bulle ivoire à filet laiton (Tutorial/bubble.png, 9-slice de 20 px) : le texte passe en encre sombre. La pointe (« hd-tut__tip ») est un
   sprite séparé posé par C# sur le bord tourné vers la cible ; le médaillon est le buste rond de Brie (planches 13.3 et 13.4). */
.hd-tut__bubble { position: absolute; left: 50%; width: 1060px; margin-left: -530px; height: auto; min-height: 250px; padding: 18px 28px 112px 180px;
    background-color: rgba(0, 0, 0, 0); border-width: 0; border-radius: 0;
    background-image: url("project://database/Assets/_Project/Resources/UI/AubeTactique/Missing20261116/Tutorial/bubble.png");
    -unity-slice-left: 20; -unity-slice-top: 20; -unity-slice-right: 20; -unity-slice-bottom: 20; display: none; }
/* Médaillon : l'image ronde porte déjà son anneau laiton, sans cadre ni masque. */
.hd-tut__medal { position: absolute; left: 24px; top: 24px; width: 136px; height: 136px; border-width: 0; border-radius: 0; overflow: visible;
    background-color: rgba(0, 0, 0, 0); -unity-background-scale-mode: scale-to-fit; }
/* Repli sans l'image ronde : portrait carré de Rayner sous masque rond. */
.hd-tut__medal.hd-tut__medal--face { left: 32px; top: 28px; width: 120px; height: 120px; border-radius: 60px; overflow: hidden;
    background-color: var(--hd-surface-3); -unity-background-scale-mode: scale-and-crop; }
.hd-tut__medal-ring { display: none; }
.hd-tut__title { align-self: flex-start; margin: 0; padding: 2px 18px; background-color: var(--hd-brass); border-radius: 0;
    -unity-font: var(--hd-font-title); font-size: 30px; color: var(--hd-ink); }
.hd-tut__body { margin: 10px 0 0 0; padding: 0; -unity-font: var(--hd-font-body); font-size: 28px; color: var(--hd-ink); white-space: normal; flex-shrink: 1; max-width: 840px; }
.hd-tut__progress { position: absolute; right: 28px; top: 18px; -unity-font: var(--hd-font-heading); font-size: 26px; color: var(--hd-brass-dark); }
.hd-tut__buttons { position: absolute; left: 180px; right: 24px; bottom: 16px; flex-direction: row; justify-content: space-between; align-items: center; }
/* Sur l'ivoire, « Compris » prend l'aspect marine du bouton secondaire (un bouton principal ivoire s'y perdrait) et perd ses ornements. */
.hd-tut__buttons > .hd-btn--primary { min-width: 300px; color: var(--hd-ivory);
    background-image: url("project://database/Assets/_Project/Art/UI/AubeTactiqueKit/Buttons/button-secondary-normal.png"); }
.hd-tut__buttons > .hd-btn--primary:hover { background-image: url("project://database/Assets/_Project/Art/UI/AubeTactiqueKit/Buttons/button-secondary-hover.png"); }
.hd-tut__buttons > .hd-btn--primary:active { background-image: url("project://database/Assets/_Project/Art/UI/AubeTactiqueKit/Buttons/button-secondary-pressed.png"); }
.hd-tut__buttons > .hd-btn--primary:focus { background-image: url("project://database/Assets/_Project/Art/UI/AubeTactiqueKit/Buttons/button-secondary-focus.png"); }
.hd-tut__buttons > .hd-btn--primary > .hd-btn__deco { display: none; }
/* « Passer » : bouton ghost (fond marine sombre) -> texte ivoire. Discret : plus bas et plus étroit que « Compris », cible tactile >= 56 px. */
.hd-tut__skip { min-height: 58px; height: 58px; min-width: 0; padding: 0 44px 0 20px; font-size: 24px; color: var(--hd-ivory); white-space: nowrap; flex-shrink: 0; }
.hd-tut__skip-chevron { position: absolute; right: 14px; top: 50%; margin-top: -10px; width: 20px; height: 20px; -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--hd-ivory); }
/* Pointe de la bulle : sprite de 48 px qui déborde de 44 px hors du bord (4 px recouvrent le filet) ; C# choisit le côté et la position le long du bord. */
.hd-tut__tip { position: absolute; width: 48px; height: 48px; display: none; -unity-background-scale-mode: scale-to-fit; }
.hd-tut__tip--down { display: flex; bottom: -44px; background-image: url("project://database/Assets/_Project/Resources/UI/AubeTactique/Missing20261116/Tutorial/pointer-down.png"); }
.hd-tut__tip--up { display: flex; top: -44px; background-image: url("project://database/Assets/_Project/Resources/UI/AubeTactique/Missing20261116/Tutorial/pointer-up.png"); }
.hd-tut__tip--left { display: flex; left: -44px; top: 50%; margin-top: -24px; background-image: url("project://database/Assets/_Project/Resources/UI/AubeTactique/Missing20261116/Tutorial/pointer-left.png"); }
.hd-tut__tip--right { display: flex; right: -44px; top: 50%; margin-top: -24px; background-image: url("project://database/Assets/_Project/Resources/UI/AubeTactique/Missing20261116/Tutorial/pointer-right.png"); }
/* Flèche de désignation, au pied de la cible : mêmes sprites que la pointe, sans teinte (le texte du Label reste vide). */
.hd-tut__pointer { width: 48px; height: 48px; -unity-background-scale-mode: scale-to-fit; -unity-background-image-tint-color: rgb(255, 255, 255); }
.hd-tut__pointer--up { background-image: url("project://database/Assets/_Project/Resources/UI/AubeTactique/Missing20261116/Tutorial/pointer-up.png"); }
.hd-tut__pointer--down { background-image: url("project://database/Assets/_Project/Resources/UI/AubeTactique/Missing20261116/Tutorial/pointer-down.png"); }
.hd-tut__pointer--left { background-image: url("project://database/Assets/_Project/Resources/UI/AubeTactique/Missing20261116/Tutorial/pointer-left.png"); }
.hd-tut__pointer--right { background-image: url("project://database/Assets/_Project/Resources/UI/AubeTactique/Missing20261116/Tutorial/pointer-right.png"); }
.hd-tut__ring { border-width: 3px; border-radius: 0; }
.hd-tut__ripple { border-width: 2px; border-radius: 0; }
.hd-tut__bracket { border-left-width: 4px; border-top-width: 4px; border-color: var(--hd-brass-soft); }

/* ---------------------------------------------------------------- Tutoriel : astuce contextuelle
   Bandeau compact en bas à gauche, au-dessus de la barre de navigation : il ne couvre ni l'en-tête ni les filtres de la page,
   ni l'action principale (en bas à droite sur les planches). */
.hd-tut__hint { position: absolute; left: 24px; margin-left: 0; top: auto; bottom: 128px; width: 46%; min-width: 620px; max-width: 900px; min-height: 0;
    flex-direction: row; align-items: center; padding: 12px 18px 12px 20px;
    background-color: rgba(0, 0, 0, 0); border-width: 0; border-radius: 0;
    background-image: url("project://database/Assets/_Project/Art/UI/AubeTactiqueKit/Surfaces/surface-tutorial.png");
    -unity-slice-left: 40; -unity-slice-top: 40; -unity-slice-right: 40; -unity-slice-bottom: 32; display: none; }
.hd-tut__hint-icon { width: 36px; height: 36px; margin-right: 16px; flex-shrink: 0; -unity-background-scale-mode: scale-to-fit; -unity-background-image-tint-color: var(--hd-info); }
.hd-tut__hint-text { flex-grow: 1; flex-shrink: 1; flex-basis: 0; min-width: 0; }
.hd-tut__hint-title { align-self: flex-start; margin: 0; padding: 0; background-color: rgba(0, 0, 0, 0); border-radius: 0;
    -unity-font: var(--hd-font-title); font-size: 24px; color: var(--hd-brass); }
.hd-tut__hint-body { margin: 2px 0 0 0; padding: 0; -unity-font: var(--hd-font-body); font-size: 24px; color: var(--hd-ivory); white-space: normal; max-width: 100%; }
.hd-tut__hint .hd-tut__hint-ok { position: relative; right: auto; bottom: auto; margin-left: 18px; min-width: 110px; flex-shrink: 0; }

/* ---- Second tour de fidélité (2026-11-16) ---- */
/* Le bouton retour garde son libellé sur une ligne (sans quoi il s'empilait lettre par lettre dans une largeur trop courte). */
.hd-btn--lead { white-space: nowrap; }
.hd-topbar__back { min-width: 230px; }
/* Les boutons qui dessinent eux-mêmes leur étoile et leur chevron (titre, QG) ne reçoivent pas ceux de l'aide commune. */
.hd-btn.login__play > .hd-btn__deco, .hd-btn.hd-qg__mission > .hd-btn__deco { display: none; }

/* ---------------------------------------------------------------- Croix de fermeture des fenêtres modales (planche 16.2)
   Un Button « hd-modal__close » ajouté en dernier enfant de la fenêtre par HdPopup (jamais dans les UXML) : il ne change donc ni l'ordre de focus
   initial ni le piège de focus. Sprite 96 px affiché en 64 px (cible de manette de 64 px, au-dessus du minimum de 48 px) ; un état par pseudo-classe.
   Les boutons Fermer et Annuler restent en pied de fenêtre. */
.hd-modal__close {
    position: absolute; top: 14px; right: 14px; width: 64px; height: 64px; min-width: 64px; min-height: 64px; margin: 0; padding: 0;
    border-width: 0; border-radius: 0; background-color: rgba(0, 0, 0, 0); -unity-background-scale-mode: scale-to-fit;
    background-image: url("project://database/Assets/_Project/Resources/UI/AubeTactique/Missing20261116/Components/close-normal.png");
}
.hd-modal__close:hover { background-image: url("project://database/Assets/_Project/Resources/UI/AubeTactique/Missing20261116/Components/close-hover.png"); }
.hd-modal__close:active { background-image: url("project://database/Assets/_Project/Resources/UI/AubeTactique/Missing20261116/Components/close-pressed.png"); }
.hd-modal__close:focus { background-image: url("project://database/Assets/_Project/Resources/UI/AubeTactique/Missing20261116/Components/close-focus.png"); }
.input--touch .hd-modal__close { width: 72px; height: 72px; min-width: 72px; min-height: 72px; }

/* ---------------------------------------------------------------- Avatars de profil (livraison S-01)
   Galerie de 12 sur une rangée : vignettes de 96 px (médaillon du kit défini par hd-entry.uss), image sous masque rond (« hd-avatar__face »).
   Sélecteurs plus précis : ils priment sur hd-entry.uss, chargé après cette feuille. */
.hd-intropop .hd-intropop__avatars { width: 96%; max-width: 1300px; }
.hd-intropop .hd-intropop__avatars > .hd-intropop__avatar { width: 96px; height: 96px; margin: 0 5px 12px 5px; border-radius: 48px; }
.hd-avatar__face { position: absolute; left: 8px; top: 8px; right: 8px; bottom: 8px; border-radius: 40px; overflow: hidden;
    background-color: var(--hd-surface-3); -unity-background-scale-mode: scale-and-crop; }

/* ---------------------------------------------------------------- Logos Google et Apple des boutons de connexion (I-10)
   Sprites blancs monochromes de l'extension (BrandIcons) : enfant « hd-btn__lead » du bouton, à gauche du libellé centré. Le bouton prend
   « hd-btn--lead » (marge gauche) ; le sélecteur à trois classes prime sur « .hd-entry__providers > .hd-btn » de hd-entry.uss. */
.hd-entry__providers > .hd-btn.hd-btn--lead { padding-left: 52px; padding-right: 20px; }
.hd-brand { -unity-background-scale-mode: scale-to-fit; -unity-background-image-tint-color: var(--hd-ivory); }
.hd-brand--google { background-image: url("project://database/Assets/_Project/Art/UI/AubeTactiqueExtension/BrandIcons/google.png"); }
.hd-brand--apple { background-image: url("project://database/Assets/_Project/Art/UI/AubeTactiqueExtension/BrandIcons/apple.png"); }
