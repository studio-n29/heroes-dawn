/* Heroes Dawn : ajustements de fidélité « planches » pour la zone entry. Importé après hd.uss : ces règles priment à spécificité égale. */

/* ---------------------------------------------------------------- Action principale : étoile laiton à gauche, chevron à droite (planches 1 et 2) */
.hd-ecta { padding: 0 84px; }
.hd-ecta__icon { position: absolute; top: 0; bottom: 0; -unity-background-scale-mode: scale-to-fit; }
.hd-ecta__icon--star {
    left: 28px; width: 42px;
    background-image: url("project://database/Assets/_Project/Art/UI/AubeTactiqueKit/IconsGold/dawn.png");
}
.hd-ecta__icon--chevron {
    right: 24px; width: 34px;
    background-image: url("project://database/Assets/_Project/Art/UI/AubeTactiqueKit/Icons/forward.png");
    -unity-background-image-tint-color: #101C29;
}
.hd-ecta__icon--light { -unity-background-image-tint-color: #ECE7DC; }
.hd-ecta:disabled > .hd-ecta__icon { opacity: 0.35; }

/* ---------------------------------------------------------------- Logotype ivoire à étoile laiton (trois fenêtres sur la même image : ivoire, or, ivoire) */
.hd-ebrand { width: 440px; height: 66px; flex-direction: row; align-self: center; flex-shrink: 0; }
.hd-ebrand__clip { height: 66px; overflow: hidden; flex-shrink: 0; }
.hd-ebrand__clip--left { width: 202px; }
.hd-ebrand__clip--star { width: 60px; }
.hd-ebrand__clip--right { width: 178px; }
.hd-ebrand__img {
    position: absolute; top: 0; width: 440px; height: 66px;
    background-image: url("project://database/Assets/_Project/Art/UI/AubeTactiqueKit/Brand/heroes-dawn-ivory.png");
    -unity-background-scale-mode: scale-to-fit;
}
.hd-ebrand__img--left { left: 0; }
.hd-ebrand__img--star {
    left: -202px;
    background-image: url("project://database/Assets/_Project/Art/UI/AubeTactiqueKit/Brand/heroes-dawn-gold.png");
}
.hd-ebrand__img--right { left: -262px; }

/* ---------------------------------------------------------------- Fenêtre d'entrée (planche 2) : illustration à gauche, contenu à droite */
.hd-entry { width: 78%; max-width: 1500px; min-width: 1240px; flex-direction: row; padding: 8px; }
.hd-entry--choice { width: 82%; max-width: 1560px; min-width: 1400px; }
.hd-entry > .hd-entry__art {
    flex-grow: 1; flex-basis: 0; flex-shrink: 1; min-width: 0; overflow: hidden;
    -unity-background-scale-mode: scale-and-crop;
    border-right-width: 2px; border-right-color: rgba(214, 175, 91, 0.55);
}
.hd-entry__art--title { background-image: url("project://database/Assets/_Project/Resources/UI/AubeTactique/hq-new-york.png"); }
.hd-entry__art--harbor { background-image: url("project://database/Assets/_Project/Resources/UI/AubeTactique/combat-red-hook.png"); }
.hd-entry__arthero {
    position: absolute; left: 0; top: 0; right: 0; bottom: 0;
    background-image: url("project://database/Assets/_Project/Resources/UI/AubeTactique/Ext/Agents/giulia_rossi-cutout.png");
    -unity-background-scale-mode: scale-and-crop; background-position: center top;
}
/* Fondu de l'illustration vers le panneau marine. */
.hd-entry__artshade {
    position: absolute; top: 0; bottom: 0; right: 0; width: 40%;
    background-image: url("project://database/Assets/_Project/Art/UI/AubeTactiqueKit/Overlays/gradient-dark-right.png");
    -unity-background-scale-mode: stretch-to-fill;
}
.hd-entry > .hd-entry__form { width: 760px; flex-shrink: 0; padding: 26px 44px 26px 40px; }
.hd-entry--choice > .hd-entry__form { width: 1060px; padding: 30px 34px 26px 30px; }
.hd-entry__form > * { flex-shrink: 0; }

/* Intitulé du mode sous le logotype : petit, laiton, espacé. */
.hd-entry__kicker {
    -unity-font: var(--hd-font-heading); font-size: 26px; color: var(--hd-brass); letter-spacing: 6px;
    margin: 2px 0 10px 0;
}
.hd-entry__tabs { margin-top: 0; }

/* Message du formulaire : bandeau avec icône (planche 2.4), absent tant qu'il n'y a rien à dire. */
.hd-entry__message {
    display: none; min-height: 56px; margin-top: 12px; padding: 8px 16px 8px 64px;
    font-size: 26px; -unity-text-align: middle-left;
    border-width: 2px; border-radius: 4px;
    background-repeat: no-repeat; background-position: 16px center; background-size: 36px 36px;
}
.hd-entry__message--shown { display: flex; }
.hd-entry__message.hd-form__message--error {
    color: #FF9C9C; border-color: #B63840; background-color: rgba(182, 56, 64, 0.22);
    background-image: url("project://database/Assets/_Project/Art/UI/AubeTactiqueKit/IconsColor/error.png");
}
.hd-entry__message.hd-form__message--ok {
    color: var(--hd-success); border-color: rgba(96, 186, 155, 0.8); background-color: rgba(96, 186, 155, 0.14);
    background-image: url("project://database/Assets/_Project/Art/UI/AubeTactiqueKit/Icons/check.png");
    -unity-background-image-tint-color: #60BA9B;
}

/* Champs : icône du kit à gauche de la saisie. */
.hd-entry__field .unity-base-text-field__input {
    padding-left: 54px;
    background-repeat: no-repeat; background-position: left center; background-size: 34px 34px;
    -unity-background-image-tint-color: #C1CDD2;
}
.hd-entry__field--mail .unity-base-text-field__input { background-image: url("project://database/Assets/_Project/Art/UI/AubeTactiqueKit/Icons/mail.png"); }
.hd-entry__field--password .unity-base-text-field__input { background-image: url("project://database/Assets/_Project/Art/UI/AubeTactiqueKit/Icons/password.png"); }
.hd-entry__field--name .unity-base-text-field__input { background-image: url("project://database/Assets/_Project/Art/UI/AubeTactiqueKit/Icons/account.png"); }

/* Lien « mot de passe oublié » : texte seul sous les champs, cible de 64 px. */
.hd-entry__link {
    min-height: 64px; margin: 4px 0 0 0; padding: 0 16px; align-self: center;
    border-width: 0; border-radius: 0; background-color: rgba(0, 0, 0, 0);
    color: var(--hd-muted); -unity-font: var(--hd-font-body); font-size: 26px; -unity-text-align: middle-center;
}
.hd-entry__link:hover { color: var(--hd-brass-soft); background-color: rgba(0, 0, 0, 0); }
.hd-entry__link:active { color: var(--hd-brass); background-color: rgba(0, 0, 0, 0); }
.hd-entry__link:focus { color: var(--hd-brass); border-bottom-width: 2px; border-bottom-color: var(--hd-brass); background-color: rgba(0, 0, 0, 0); }

.hd-entry__providers > .hd-btn { font-size: 27px; padding: 0 12px; margin: 0 6px; }
.hd-entry__footer > .hd-btn { max-width: 300px; }
.hd-entry__footer--end { justify-content: flex-end; }

/* ---------------------------------------------------------------- Choix de progression (planche 2.3) */
.hd-choice__title { -unity-text-align: middle-left; font-size: 50px; white-space: normal; margin: 0 10px 0 10px; }
.hd-choice__hint { -unity-text-align: upper-left; font-size: 26px; margin: 6px 10px 18px 10px; }
.hd-choice__card { padding: 22px 24px 24px 24px; }
.hd-choice__head { flex-direction: row; align-items: center; flex-shrink: 0; }
.hd-choice__icon {
    width: 44px; height: 44px; margin-right: 14px; flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit; -unity-background-image-tint-color: #D6AF5B;
}
.hd-choice__icon--device { background-image: url("project://database/Assets/_Project/Art/UI/AubeTactiqueKit/Icons/save.png"); }
.hd-choice__icon--account { background-image: url("project://database/Assets/_Project/Art/UI/AubeTactiqueKit/Icons/cloud.png"); }
.hd-choice__header { flex-grow: 1; flex-basis: 0; min-width: 0; color: var(--hd-ivory); -unity-text-align: middle-left; white-space: normal; }
.hd-choice__card--account .hd-choice__header { color: var(--hd-ivory); }
.hd-choice__rule { height: 2px; flex-shrink: 0; margin-top: 12px; background-color: rgba(214, 175, 91, 0.45); }
.hd-choice__summary { -unity-text-align: upper-left; font-size: 26px; margin: 14px 0 20px 0; }
.hd-choice__card > .hd-btn { font-size: 34px; padding: 0 16px; flex-shrink: 0; }

/* ---------------------------------------------------------------- Ouverture de chapitre */
.hd-chapter__heading { margin-top: 6px; white-space: normal; }
.hd-chapter__divider {
    height: 44px; flex-shrink: 0; margin: 0 0 10px 0;
    background-image: url("project://database/Assets/_Project/Art/UI/AubeTactiqueKit/Decorations/divider-star.png");
    -unity-background-scale-mode: scale-to-fit;
}
/* Le texte prend sa hauteur (plus de vide sous un texte court) et défile au-delà de 300 px. */
.hd-chapter__scroll { height: auto; min-height: 120px; max-height: 300px; margin-bottom: 18px; }
.hd-chapter__text { font-size: 30px; }
.hd-chapter__buttons > .hd-btn { max-width: 520px; }
/* Illustration d'un souvenir (fenêtre LIRE) : 16:9 conservé (569 x 320), centrée au-dessus du texte ; cadre laiton fin. */
.hd-chapter__memoryart {
    display: none; /* caché tant que la vue n'a pas d'illustration de souvenir (le prefab à vide ne doit pas réserver 320 px) */
    width: 569px; height: 320px; max-width: 100%; flex-shrink: 0; align-self: center; margin-bottom: 10px;
    border-width: 2px; border-color: var(--hd-brass-dark);
    -unity-background-scale-mode: scale-to-fit; background-position: center;
}
/* Vignettes de la page Chapitres : un chapitre verrouillé ou à venir garde son image, voilée et assombrie. */
.hd-listpage .hd-row--dim .hd-row__tag--art { -unity-background-image-tint-color: rgb(105, 110, 120); }

/* ---------------------------------------------------------------- Introduction : cinématique et création du personnage (planche 1.4) */
.hd-intropop__skip { right: 36px; top: 30px; padding: 0 66px 0 30px; font-size: 28px; opacity: 0.92; }
.hd-intropop__divider {
    width: 520px; height: 40px; flex-shrink: 0; margin-top: 4px;
    background-image: url("project://database/Assets/_Project/Art/UI/AubeTactiqueKit/Decorations/divider-star.png");
    -unity-background-scale-mode: scale-to-fit;
}
.hd-intropop__name { margin-top: 44px; }
.hd-intropop__avatars { margin-top: 48px; }
/* Vignettes : médaillon du kit, anneau laiton quand l'avatar est choisi. */
.hd-intropop__avatar {
    border-width: 0; border-radius: 75px; background-color: rgba(27, 43, 59, 0.92);
    background-image: url("project://database/Assets/_Project/Art/UI/AubeTactiqueKit/Frames/portrait-empty.png");
    -unity-background-scale-mode: scale-to-fit;
}
.hd-intropop__avatar--on {
    background-color: var(--hd-surface-2);
    background-image: url("project://database/Assets/_Project/Art/UI/AubeTactiqueKit/Frames/portrait-selected.png");
}
.hd-intropop__avatarnum { font-size: 56px; }

/* ---------------------------------------------------------------- Première connexion : Rayner en Full Art, fiche d'identification, choix de la ville */
.hd-intropop__rayner { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: var(--hd-ink-deep); }
.hd-intropop__rayner-art { position: absolute; left: 0; top: 0; right: 0; bottom: 0; -unity-background-scale-mode: scale-and-crop; }
.hd-intropop__rayner-shade { position: absolute; left: 0; right: 0; bottom: 0; height: 52%; background-color: rgba(10, 17, 26, 0.78); }
.hd-intropop__rayner-box { position: absolute; left: 90px; right: 90px; bottom: 70px; padding: 24px 40px 28px 40px; background-color: rgba(16, 28, 42, 0.94); border-width: 3px; border-color: var(--hd-brass); border-radius: 8px; }
.hd-intropop__rayner-name { -unity-font: var(--hd-font-title); font-size: 40px; color: var(--hd-brass); }
.hd-intropop__rayner-text { -unity-font: var(--hd-font-body); font-size: 38px; color: var(--hd-ivory); white-space: normal; margin-top: 10px; min-height: 130px; }
.hd-intropop__rayner-hint { -unity-font: var(--hd-font-heading); font-size: 26px; color: var(--hd-muted); -unity-text-align: middle-right; margin-top: 6px; }

.hd-intropop__formrow { flex-direction: row; justify-content: center; margin-top: 18px; }
.hd-intropop__formcol { width: 780px; margin: 0 28px; }
.hd-intropop__fieldlabel { -unity-font: var(--hd-font-heading); font-size: 28px; color: var(--hd-brass-soft); margin-top: 8px; }
.hd-intropop__field { width: 100%; margin: 2px 0; }
.hd-intropop__field--age { width: 220px; }
.hd-intropop__avatars--form { width: 100%; margin-top: 6px; justify-content: flex-start; }
.hd-intropop__avatars--form > .hd-intropop__avatar { width: 112px; height: 112px; margin: 0 12px 12px 0; border-radius: 56px; }
.hd-intropop__power { height: 72px; justify-content: space-between; padding: 0 22px; font-size: 30px; width: 100%; -unity-text-align: middle-left; }
.hd-intropop__error { -unity-font: var(--hd-font-body); font-size: 28px; color: var(--hd-danger); margin-top: 8px; min-height: 36px; }
.hd-intropop__char > .hd-intropop__confirm { position: relative; bottom: 0; margin-top: 10px; }

/* Tableau des pouvoirs : une colonne par famille, au-dessus de la fiche. */
.hd-intropop__powersheet { position: absolute; left: 60px; right: 60px; top: 150px; bottom: 140px; display: none; background-color: rgba(10, 17, 26, 0.97); border-width: 3px; border-color: var(--hd-brass); border-radius: 8px; padding: 18px; }
.hd-intropop__powersheet--open { display: flex; }
.hd-intropop__powerscroll { flex-grow: 1; }
.hd-intropop__powertable { flex-direction: row; justify-content: space-between; }
.hd-intropop__powercol { flex-grow: 1; flex-basis: 0; margin: 0 8px; }
.hd-intropop__powerhead { -unity-font: var(--hd-font-title); font-size: 34px; color: var(--hd-ink); background-color: var(--hd-brass); -unity-text-align: middle-center; padding: 8px 4px; border-radius: 6px; margin-bottom: 10px; }
.hd-intropop__powerhead--matiere { background-color: var(--hd-matter); }
.hd-intropop__powerhead--elementaire { background-color: var(--hd-elemental); }
.hd-intropop__powerhead--physique_bio { background-color: var(--hd-physical-bio); }
.hd-intropop__powerhead--perception { background-color: var(--hd-perception); }
.hd-intropop__poweritem { height: 72px; margin: 0 0 8px 0; font-size: 28px; -unity-text-align: middle-left; padding: 0 16px; background-color: var(--hd-surface); color: var(--hd-ivory); border-width: 2px; border-color: var(--hd-brass-dark); border-radius: 6px; white-space: normal; }
.hd-intropop__poweritem--on { background-color: var(--hd-surface-2); border-color: var(--hd-brass-soft); color: var(--hd-brass-soft); }

/* Choix de la ville de départ : deux grandes cartes. */
.hd-intropop__startcards { flex-direction: row; justify-content: center; margin-top: 70px; }
.hd-intropop__startcard { width: 640px; min-height: 520px; margin: 0 30px; padding: 36px; background-color: var(--hd-surface-3); border-width: 4px; border-color: var(--hd-brass-dark); border-radius: 12px; align-items: center; }
.hd-intropop__startcard--off { opacity: 0.45; }
.hd-intropop__startcity { -unity-font: var(--hd-font-title); font-size: 72px; color: var(--hd-ivory); }
.hd-intropop__startagent { -unity-font: var(--hd-font-heading); font-size: 40px; color: var(--hd-brass); margin-top: 6px; }
.hd-intropop__startdesc { -unity-font: var(--hd-font-body-regular); font-size: 32px; color: var(--hd-muted); white-space: normal; margin-top: 30px; -unity-text-align: upper-center; }
.hd-intropop__startsoon { -unity-font: var(--hd-font-heading); font-size: 36px; color: var(--hd-brass-soft); margin-top: 30px; }
