/* Heroes Dawn : écran Profil (planche 12.2) et liste des succès. Importé après hd.uss.
   Mise en page proportionnelle (pourcentages et flex) : aucune largeur fixe, l'écran suit le format (16:9, 4:3, ultra-large). */

.hd-profile { flex-direction: row; padding: 0 88px; }

/* Agent détouré à gauche (planche) : cadré en bas, derrière les panneaux. */
.hd-profile__hero {
    position: absolute; left: 0; bottom: 0; width: 30%; height: 100%;
    -unity-background-scale-mode: scale-to-fit; opacity: 0.95;
}
.hd-profile__main { flex-grow: 1; flex-shrink: 1; min-width: 0; }

/* Bandeau : avatar rond, nom + tag, bloc Compte à droite. */
.hd-profile__top { flex-direction: row; align-items: center; margin-bottom: 18px; flex-shrink: 0; }
.hd-profile__avatar {
    width: 132px; height: 132px; min-width: 132px; margin: 0 24px 0 0; padding: 0; flex-shrink: 0;
    border-radius: 66px; border-width: 4px; border-color: var(--hd-brass); background-color: var(--hd-surface-3);
    -unity-background-scale-mode: scale-and-crop; align-items: center; justify-content: center; overflow: hidden;
}
.hd-profile__avatar:hover { border-color: var(--hd-brass-soft); }
.hd-profile__avatar:focus { border-color: var(--hd-ivory); }
.hd-profile__avatar-initial { -unity-font: var(--hd-font-title); font-size: 64px; color: var(--hd-ivory); }
.hd-profile__id { flex-shrink: 1; min-width: 0; justify-content: center; }
.hd-profile__pseudo { -unity-font: var(--hd-font-title); font-size: 72px; color: var(--hd-ivory); white-space: nowrap; overflow: hidden; margin: 0; padding: 0; }
.hd-profile__tag {
    flex-direction: row; align-self: flex-start; margin: 0; padding: 2px 0; border-width: 0; background-color: rgba(0, 0, 0, 0); border-radius: 0;
}
.hd-profile__tag-text { -unity-font: var(--hd-font-heading); font-size: 40px; color: var(--hd-muted); white-space: nowrap; margin: 0; padding: 0; }
.hd-profile__tag:hover .hd-profile__tag-text { color: var(--hd-brass-soft); }
.hd-profile__rank { font-size: 28px; color: var(--hd-muted); -unity-font: var(--hd-font-body); white-space: nowrap; overflow: hidden; margin: 4px 0 0 0; padding: 0; }

.hd-profile__account { flex-direction: row; align-items: center; flex-shrink: 1; min-width: 0; padding: 12px 20px; }
.hd-profile__account-label { -unity-font: var(--hd-font-heading); font-size: 32px; color: var(--hd-ivory); margin: 0 16px 0 0; flex-shrink: 1; min-width: 0; white-space: nowrap; overflow: hidden; }
.hd-profile__btn { margin: 0 0 0 10px; flex-shrink: 0; }

/* Corps : un vide à gauche pour l'agent, puis stats (3 parts) et amis (2 parts). */
.hd-profile__body { flex-direction: row; flex-grow: 1; flex-shrink: 1; min-height: 0; }
.hd-profile__gap { width: 22%; flex-shrink: 1; }
.hd-profile__stats { flex-grow: 3; flex-basis: 0; min-width: 0; margin-right: 18px; padding: 20px 28px; }
.hd-profile__friends { flex-grow: 2; flex-basis: 0; min-width: 0; padding: 20px 28px; }

.hd-profile__head { flex-direction: row; align-items: center; margin-bottom: 12px; flex-shrink: 0; }
.hd-profile__star {
    width: 40px; height: 40px; margin-right: 12px; flex-shrink: 0; -unity-background-scale-mode: scale-to-fit;
    background-image: url("project://database/Assets/_Project/Art/UI/AubeTactiqueKit/Icons/dawn.png"); -unity-background-image-tint-color: var(--hd-brass);
}
.hd-profile__title { -unity-font: var(--hd-font-heading); font-size: 44px; color: var(--hd-ivory); margin: 0; padding: 0; white-space: nowrap; overflow: hidden; }
.hd-profile__caption { font-size: 26px; color: var(--hd-muted); margin: 0; padding: 0; white-space: normal; }

/* Grille 3 × 2 : chaque tuile prend un tiers de la largeur et la moitié de la hauteur. */
.hd-profile__tiles { flex-direction: row; flex-wrap: wrap; flex-grow: 1; min-height: 0; }
.hd-tile {
    width: 33.33%; height: 50%; min-height: 150px; margin: 0; padding: 8px; flex-shrink: 0;
    align-items: center; justify-content: center; border-width: 0; border-radius: 0; background-color: rgba(0, 0, 0, 0);
    border-right-width: 1px; border-bottom-width: 1px; border-color: rgba(214, 175, 91, 0.25);
}
.hd-tile:hover { background-color: rgba(214, 175, 91, 0.08); }
.hd-tile:focus { border-color: var(--hd-brass); background-color: rgba(214, 175, 91, 0.12); }
.hd-tile:disabled { opacity: 1; }
.hd-tile__icon { width: 44px; height: 44px; -unity-background-scale-mode: scale-to-fit; -unity-background-image-tint-color: var(--hd-brass); }
.hd-tile__label { font-size: 28px; color: var(--hd-muted); -unity-text-align: middle-center; white-space: normal; margin: 4px 0 0 0; padding: 0; }
.hd-tile__value { -unity-font: var(--hd-font-title); font-size: 72px; color: var(--hd-ivory); -unity-text-align: middle-center; margin: 0; padding: 0; }
.hd-tile--tap .hd-tile__label { color: var(--hd-brass-soft); }
.hd-tile--level .hd-tile__icon { background-image: url("project://database/Assets/_Project/Art/UI/AubeTactiqueKit/Icons/level.png"); }
.hd-tile--agents .hd-tile__icon { background-image: url("project://database/Assets/_Project/Art/UI/AubeTactiqueKit/Icons/team.png"); }
.hd-tile--operations .hd-tile__icon { background-image: url("project://database/Assets/_Project/Art/UI/AubeTactiqueKit/Icons/operations.png"); }
.hd-tile--missions .hd-tile__icon { background-image: url("project://database/Assets/_Project/Art/UI/AubeTactiqueKit/Icons/quest.png"); }
.hd-tile--achievements .hd-tile__icon { background-image: url("project://database/Assets/_Project/Art/UI/AubeTactiqueKit/Icons/trophy.png"); }
.hd-tile--lair .hd-tile__icon { background-image: url("project://database/Assets/_Project/Art/UI/AubeTactiqueKit/Icons/boss.png"); }

/* Amis. */
.hd-profile__friend-rows { flex-grow: 1; flex-shrink: 1; min-height: 0; }
.hd-friend { flex-direction: row; align-items: center; padding: 8px 0; border-bottom-width: 1px; border-color: rgba(214, 175, 91, 0.2); }
.hd-friend__portrait {
    width: 80px; height: 80px; margin-right: 14px; flex-shrink: 0; border-width: 2px; border-color: var(--hd-brass-dark);
    background-color: var(--hd-surface-3); align-items: center; justify-content: center;
}
.hd-friend__initial { -unity-font: var(--hd-font-title); font-size: 44px; color: var(--hd-ivory); }
.hd-friend__text { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.hd-friend__name { -unity-font: var(--hd-font-heading); font-size: 34px; color: var(--hd-ivory); white-space: nowrap; overflow: hidden; margin: 0; padding: 0; }
.hd-friend__tag { font-size: 24px; color: var(--hd-muted); white-space: nowrap; overflow: hidden; margin: 0; padding: 0; }
.hd-friend__status { flex-direction: row; align-items: center; flex-shrink: 0; margin: 0 8px; }
.hd-friend__dot { width: 16px; height: 16px; border-radius: 8px; margin-right: 8px; background-color: var(--hd-muted); }
.hd-friend__dot--online { background-color: var(--hd-success); }
.hd-friend__status-text { font-size: 24px; color: var(--hd-muted); margin: 0; padding: 0; white-space: nowrap; }
.hd-friend__btn { min-height: 56px; margin: 0 0 0 6px; padding: 0 14px; font-size: 26px; flex-shrink: 0; }
.hd-profile__empty { font-size: 28px; color: var(--hd-muted); white-space: normal; padding: 16px 0; flex-shrink: 0; }
.hd-profile__add { align-self: stretch; margin: 12px 0 0 0; flex-shrink: 0; }

/* Liens du bas : registre, archives, tournoi (alignés à droite de l'agent). */
.hd-profile__links { flex-direction: row; flex-shrink: 0; margin-top: 16px; }
.hd-profile__link { flex-grow: 1; flex-basis: 0; min-width: 0; margin: 0 12px 0 0; }

/* Liste complète des succès : recouvre la grille et les amis. */
.hd-profile__achievements { display: none; position: absolute; left: 22%; right: 88px; top: 12px; bottom: 12px; padding: 20px 28px; }
.hd-profile__back { margin: 0 20px 0 0; flex-shrink: 0; }
.hd-profile__ach-text { flex-shrink: 1; min-width: 0; }
.hd-profile__ach-rows { flex-grow: 1; min-height: 0; }
.hd-ach { flex-direction: row; align-items: center; padding: 10px 0; border-bottom-width: 1px; border-color: rgba(214, 175, 91, 0.2); }
.hd-ach__mark { width: 40px; height: 40px; margin-right: 16px; flex-shrink: 0; border-radius: 20px; border-width: 2px; border-color: var(--hd-muted); }
.hd-ach__mark--on { background-color: var(--hd-success); border-color: var(--hd-success); }
.hd-ach__text { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.hd-ach__name { -unity-font: var(--hd-font-heading); font-size: 34px; color: var(--hd-ivory); margin: 0; padding: 0; white-space: normal; }
.hd-ach__desc { font-size: 24px; color: var(--hd-muted); margin: 0; padding: 0; white-space: normal; }
.hd-ach__progress { font-size: 26px; color: var(--hd-brass-soft); flex-shrink: 0; margin-left: 16px; white-space: nowrap; }
.hd-ach--locked .hd-ach__name { color: var(--hd-muted); }

/* Écran étroit (4:3 ou fenêtre réduite) : l'agent recule et le vide à gauche se réduit. */
.hd-profile--narrow .hd-profile__gap { width: 8%; }
.hd-profile--narrow .hd-profile__hero { width: 22%; opacity: 0.45; }
.hd-profile--narrow .hd-profile__pseudo { font-size: 56px; }
.hd-profile--narrow .hd-profile__achievements { left: 88px; }

/* ---------------------------------------------------------------- Tournoi (planches 13.1 / 13.2) */
.hd-tourney { padding: 0 88px; }
.hd-tourney__bar { flex-direction: row; align-items: center; padding: 14px 28px; margin-bottom: 18px; flex-shrink: 0; }
.hd-tourney__star { width: 56px; height: 56px; margin-right: 16px; flex-shrink: 0; -unity-background-scale-mode: scale-to-fit;
    background-image: url("project://database/Assets/_Project/Art/UI/AubeTactiqueKit/Icons/dawn.png"); -unity-background-image-tint-color: var(--hd-brass); }
.hd-tourney__title { -unity-font: var(--hd-font-title); font-size: 64px; color: var(--hd-ivory); margin: 0; padding: 0; white-space: nowrap; overflow: hidden; flex-shrink: 1; min-width: 0; }
.hd-tourney__state { -unity-font: var(--hd-font-heading); font-size: 32px; color: var(--hd-brass); margin: 0 0 0 16px; padding: 4px 22px; flex-shrink: 0;
    border-width: 2px; border-color: var(--hd-brass); border-radius: 8px; background-color: rgba(10, 17, 26, 0.6); }
.hd-tourney__body { flex-direction: row; flex-grow: 1; flex-shrink: 1; min-height: 0; }
.hd-tourney__ranking { flex-grow: 1; flex-basis: 0; flex-shrink: 1; min-width: 0; margin-right: 18px; padding: 20px 28px; }
.hd-tourney__side { flex-grow: 1; flex-basis: 0; flex-shrink: 1; min-width: 0; }
.hd-tourney__head { -unity-font: var(--hd-font-heading); font-size: 44px; color: var(--hd-ivory); margin: 0 0 12px 0; padding: 0; flex-shrink: 0; white-space: nowrap; overflow: hidden; }
.hd-tourney__rows { flex-grow: 1; min-height: 0; }
.hd-tourney__empty { font-size: 28px; color: var(--hd-muted); white-space: normal; flex-shrink: 0; padding: 16px 0; }
.hd-rank { flex-direction: row; align-items: center; padding: 8px 14px; margin-bottom: 6px; border-width: 1px; border-color: rgba(214, 175, 91, 0.25); background-color: rgba(10, 17, 26, 0.5); }
.hd-rank--me { background-color: rgba(214, 175, 91, 0.9); border-color: var(--hd-brass-soft); }
.hd-rank__n { -unity-font: var(--hd-font-title); font-size: 40px; color: var(--hd-brass); width: 60px; flex-shrink: 0; margin: 0; padding: 0; }
.hd-rank__name { -unity-font: var(--hd-font-heading); font-size: 36px; color: var(--hd-ivory); flex-grow: 1; flex-shrink: 1; min-width: 0; white-space: nowrap; overflow: hidden; margin: 0; padding: 0; }
.hd-rank__pts { -unity-font: var(--hd-font-heading); font-size: 34px; color: var(--hd-muted); flex-shrink: 0; margin: 0 0 0 12px; padding: 0; white-space: nowrap; }
.hd-rank--me .hd-rank__n, .hd-rank--me .hd-rank__name, .hd-rank--me .hd-rank__pts { color: var(--hd-ink); }
.hd-tourney__tiers { padding: 18px 28px; margin-bottom: 14px; flex-shrink: 0; }
.hd-tourney__chips { flex-direction: row; justify-content: space-between; }
.hd-chip { flex-grow: 1; flex-basis: 0; min-width: 0; margin: 0 5px; padding: 10px 4px; align-items: center; justify-content: center;
    border-width: 2px; border-radius: 10px; border-color: var(--hd-muted); background-color: rgba(10, 17, 26, 0.6); }
.hd-chip__label { -unity-font: var(--hd-font-heading); font-size: 28px; color: var(--hd-muted); margin: 0; padding: 0; white-space: nowrap; overflow: hidden; }
.hd-chip--done { border-color: var(--hd-success); background-color: rgba(96, 186, 155, 0.25); }
.hd-chip--done .hd-chip__label { color: var(--hd-ivory); }
.hd-chip--current { border-color: var(--hd-brass); background-color: rgba(214, 175, 91, 0.9); }
.hd-chip--current .hd-chip__label { color: var(--hd-ink); }
.hd-tourney__status { padding: 18px 28px; flex-grow: 1; flex-shrink: 1; min-height: 0; margin-bottom: 14px; }
.hd-tourney__main { -unity-font: var(--hd-font-title); font-size: 56px; color: var(--hd-ivory); margin: 0; padding: 0; }
.hd-tourney__progress { height: 22px; margin: 10px 0; flex-shrink: 0; }
.hd-tourney__sub { font-size: 28px; color: var(--hd-muted); white-space: normal; margin: 0; padding: 0; }
.hd-tourney__actions { flex-direction: row; flex-shrink: 0; justify-content: flex-end; }
.hd-tourney__btn { margin: 0 0 0 12px; flex-shrink: 1; min-width: 0; }
.hd-tourney--narrow .hd-tourney__body { flex-direction: column; }
.hd-tourney--narrow .hd-tourney__ranking { margin-right: 0; margin-bottom: 14px; }

/* ---------------------------------------------------------------- Repaire (planche 12.4) */
.hd-lair { flex-direction: row; padding: 0 88px; }
.hd-lair__hero { position: absolute; right: 0; top: 0; width: 46%; height: 100%; -unity-background-scale-mode: scale-to-fit; opacity: 0.95; }
.hd-lair__list { width: 32%; min-width: 0; flex-shrink: 1; margin-right: 18px; padding: 20px 24px; }
.hd-lair__rows { flex-grow: 1; min-height: 0; }
.hd-boss { flex-direction: row; align-items: center; padding: 8px; margin-bottom: 10px; border-width: 2px; border-color: rgba(214, 175, 91, 0.25); background-color: rgba(10, 17, 26, 0.6); border-radius: 0; }
.hd-boss:hover { border-color: var(--hd-brass-soft); }
.hd-boss--selected { border-color: var(--hd-brass); background-color: rgba(214, 175, 91, 0.18); }
.hd-boss--locked .hd-boss__name { color: var(--hd-muted); }
.hd-boss__portrait { width: 120px; height: 100px; margin-right: 14px; flex-shrink: 0; -unity-background-scale-mode: scale-and-crop; background-color: var(--hd-surface-3); }
.hd-boss__text { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.hd-boss__name { -unity-font: var(--hd-font-heading); font-size: 38px; color: var(--hd-ivory); margin: 0; padding: 0; white-space: nowrap; overflow: hidden; }
.hd-boss__level { font-size: 26px; color: var(--hd-muted); margin: 0; padding: 0; }
.hd-boss__bar { height: 12px; margin-top: 6px; }
.hd-lair__sheet { flex-grow: 1; flex-basis: 0; min-width: 0; align-items: flex-end; }
.hd-lair__id { align-items: flex-end; flex-shrink: 0; margin-bottom: 8px; }
.hd-lair__name { -unity-font: var(--hd-font-title); font-size: 84px; color: var(--hd-ivory); margin: 0; padding: 0; white-space: nowrap; }
.hd-lair__sub { font-size: 32px; color: var(--hd-muted); margin: 0; padding: 0; }
.hd-lair__spacer { flex-grow: 1; }
.hd-lair__info { width: 80%; min-width: 0; flex-shrink: 0; padding: 18px 26px; margin-bottom: 14px; }
.hd-lair__head { -unity-font: var(--hd-font-heading); font-size: 38px; color: var(--hd-brass); margin: 4px 0; padding: 0; }
.hd-lair__progressrow { flex-direction: row; align-items: center; }
.hd-lair__bar { flex-grow: 1; height: 22px; margin-right: 14px; }
.hd-lair__pct { -unity-font: var(--hd-font-heading); font-size: 34px; color: var(--hd-ivory); margin: 0; padding: 0; }
.hd-lair__lore { font-size: 28px; color: var(--hd-ivory); white-space: normal; margin: 0 0 8px 0; padding: 0; }
.hd-lair__reward { font-size: 26px; color: var(--hd-muted); white-space: normal; margin: 0; padding: 0; }
.hd-lair__enter { width: 80%; align-self: flex-end; margin: 0; flex-shrink: 0; }
.hd-lair--narrow .hd-lair__list { width: 40%; }
.hd-lair--narrow .hd-lair__info, .hd-lair--narrow .hd-lair__enter { width: 100%; }
.hd-lair--narrow .hd-lair__hero { width: 60%; opacity: 0.4; }
.hd-lair--narrow .hd-lair__name { font-size: 64px; }

/* ---------------------------------------------------------------- Onglets du QG (QG · Tournois · Repaires) */
.hd-qg__subtabs { flex-direction: row; flex-shrink: 0; margin-bottom: 14px; }
.hd-qg__subtab { min-height: 64px; margin: 0 10px 0 0; padding: 0 28px; font-size: 30px; flex-shrink: 1; min-width: 0; }
