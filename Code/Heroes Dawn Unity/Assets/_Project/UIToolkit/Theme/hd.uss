/* Heroes Dawn : thème UI Toolkit (jetons, base et composants). Une seule source pour toutes les vues. */

:root {
    /* Couleurs de la charte */
    --hd-ink: #101C29;
    --hd-ink-deep: #0A111A;
    --hd-ivory: #ECE7DC;
    --hd-brass: #D6AF5B;
    --hd-brass-soft: #E7CF98;
    --hd-brass-dark: #95743C;
    --hd-surface: #263B4C;
    --hd-surface-2: #304959;
    --hd-surface-3: #1B2B3B;
    --hd-muted: #C1CDD2;
    --hd-danger: #B63840;
    --hd-success: #60BA9B;
    --hd-info: #87B8CE;
    --hd-hp: #4CE06B;
    --hd-fatigue: #FF9F43;
    --hd-credits: #FFC53D;
    --hd-pr: #3AD6A0;
    --hd-gems: #B07CFF;
    /* Familles */
    --hd-matter: #FFB547;
    --hd-elemental: #3CD7FF;
    --hd-physical-bio: #FF5C7A;
    --hd-perception: #B07CFF;
    /* Polices */
    --hd-font-title: url("project://database/Assets/_Project/Art/UI/AubeTactiqueKit/Fonts/BarlowCondensed-ExtraBoldItalic.ttf");
    --hd-font-heading: url("project://database/Assets/_Project/Art/UI/AubeTactiqueKit/Fonts/BarlowCondensed-SemiBold.ttf");
    --hd-font-body: url("project://database/Assets/_Project/Art/UI/AubeTactiqueKit/Fonts/Barlow-SemiBold.ttf");
    --hd-font-body-regular: url("project://database/Assets/_Project/Art/UI/AubeTactiqueKit/Fonts/Barlow-Regular.ttf");
    /* Échelle typographique (résolution de référence 1920 x 1080) */
    --hd-text-caption: 24px;
    --hd-text-body: 28px;
    --hd-text-heading: 36px;
    --hd-text-title: 54px;
    --hd-text-display: 84px;
    /* Espacements et cibles */
    --hd-gap: 16px;
    --hd-gap-lg: 28px;
    --hd-target: 96px;
}

/* Le conteneur de modèle d'un document remplit toujours le panneau. */
TemplateContainer { width: 100%; height: 100%; flex-grow: 1; }

.hd-screen { width: 100%; height: 100%; position: relative; }
.hd-fill { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.hd-passive { picking-mode: ignore; }

/* ---------------------------------------------------------------- Texte */
.hd-text { color: var(--hd-ivory); -unity-font: var(--hd-font-body); font-size: var(--hd-text-body); white-space: normal; }
.hd-text--muted { color: var(--hd-muted); }
.hd-text--caption { font-size: var(--hd-text-caption); color: var(--hd-muted); }
.hd-text--heading { -unity-font: var(--hd-font-heading); font-size: var(--hd-text-heading); }
.hd-text--title { -unity-font: var(--hd-font-title); font-size: var(--hd-text-title); }
.hd-text--display { -unity-font: var(--hd-font-title); font-size: var(--hd-text-display); }
.hd-text--gold { color: var(--hd-brass); }
.hd-text--danger { color: var(--hd-danger); }
.hd-text--success { color: var(--hd-success); }
.hd-text--center { -unity-text-align: middle-center; }
.hd-text--right { -unity-text-align: middle-right; }
.hd-text--ellipsis { text-overflow: ellipsis; white-space: nowrap; overflow: hidden; }

/* ---------------------------------------------------------------- Boutons (kit : 5 variantes x 5 états) */
.hd-btn {
    min-height: 88px; margin: 0; padding: 0 36px;
    border-width: 0; border-radius: 0; background-color: rgba(255, 255, 255, 0);
    -unity-slice-left: 40; -unity-slice-top: 40; -unity-slice-right: 40; -unity-slice-bottom: 24;
    -unity-font: var(--hd-font-title); font-size: 40px; -unity-text-align: middle-center;
    transition: scale 0.08s ease-out;
}
.hd-btn:hover { scale: 1.015 1.015; }
.hd-btn:active { scale: 0.985 0.985; }
.hd-btn--primary { background-image: url("project://database/Assets/_Project/Art/UI/AubeTactiqueKit/Buttons/button-primary-normal.png"); color: var(--hd-ink); }
.hd-btn--primary:hover { background-image: url("project://database/Assets/_Project/Art/UI/AubeTactiqueKit/Buttons/button-primary-hover.png"); }
.hd-btn--primary:active { background-image: url("project://database/Assets/_Project/Art/UI/AubeTactiqueKit/Buttons/button-primary-pressed.png"); }
.hd-btn--primary:focus { background-image: url("project://database/Assets/_Project/Art/UI/AubeTactiqueKit/Buttons/button-primary-focus.png"); }
.hd-btn--primary:disabled { background-image: url("project://database/Assets/_Project/Art/UI/AubeTactiqueKit/Buttons/button-primary-disabled.png"); color: rgba(236, 231, 220, 0.55); }
.hd-btn--secondary { background-image: url("project://database/Assets/_Project/Art/UI/AubeTactiqueKit/Buttons/button-secondary-normal.png"); color: var(--hd-ivory); }
.hd-btn--secondary:hover { background-image: url("project://database/Assets/_Project/Art/UI/AubeTactiqueKit/Buttons/button-secondary-hover.png"); }
.hd-btn--secondary:active { background-image: url("project://database/Assets/_Project/Art/UI/AubeTactiqueKit/Buttons/button-secondary-pressed.png"); }
.hd-btn--secondary:focus { background-image: url("project://database/Assets/_Project/Art/UI/AubeTactiqueKit/Buttons/button-secondary-focus.png"); }
.hd-btn--secondary:disabled { background-image: url("project://database/Assets/_Project/Art/UI/AubeTactiqueKit/Buttons/button-secondary-disabled.png"); color: rgba(236, 231, 220, 0.45); }
.hd-btn--ghost { background-image: url("project://database/Assets/_Project/Art/UI/AubeTactiqueKit/Buttons/button-ghost-normal.png"); color: var(--hd-ivory); }
.hd-btn--ghost:hover { background-image: url("project://database/Assets/_Project/Art/UI/AubeTactiqueKit/Buttons/button-ghost-hover.png"); }
.hd-btn--ghost:active { background-image: url("project://database/Assets/_Project/Art/UI/AubeTactiqueKit/Buttons/button-ghost-pressed.png"); }
.hd-btn--ghost:focus { background-image: url("project://database/Assets/_Project/Art/UI/AubeTactiqueKit/Buttons/button-ghost-focus.png"); }
.hd-btn--ghost:disabled { background-image: url("project://database/Assets/_Project/Art/UI/AubeTactiqueKit/Buttons/button-ghost-disabled.png"); color: rgba(236, 231, 220, 0.45); }
.hd-btn--danger { background-image: url("project://database/Assets/_Project/Art/UI/AubeTactiqueKit/Buttons/button-danger-normal.png"); color: var(--hd-ivory); }
.hd-btn--danger:hover { background-image: url("project://database/Assets/_Project/Art/UI/AubeTactiqueKit/Buttons/button-danger-hover.png"); }
.hd-btn--danger:active { background-image: url("project://database/Assets/_Project/Art/UI/AubeTactiqueKit/Buttons/button-danger-pressed.png"); }
.hd-btn--danger:focus { background-image: url("project://database/Assets/_Project/Art/UI/AubeTactiqueKit/Buttons/button-danger-focus.png"); }
.hd-btn--danger:disabled { background-image: url("project://database/Assets/_Project/Art/UI/AubeTactiqueKit/Buttons/button-danger-disabled.png"); color: rgba(236, 231, 220, 0.45); }
.hd-btn--nav { background-image: url("project://database/Assets/_Project/Art/UI/AubeTactiqueKit/Buttons/button-secondary-normal.png"); color: var(--hd-muted); min-height: 96px; }
.hd-btn--nav:hover { background-image: url("project://database/Assets/_Project/Art/UI/AubeTactiqueKit/Buttons/button-secondary-hover.png"); }
.hd-btn--nav:focus { background-image: url("project://database/Assets/_Project/Art/UI/AubeTactiqueKit/Buttons/button-secondary-focus.png"); }
.hd-btn--nav-active, .hd-btn--nav-active:hover, .hd-btn--nav-active:focus { background-image: url("project://database/Assets/_Project/Art/UI/AubeTactiqueKit/Buttons/button-nav-normal.png"); color: var(--hd-ink); }
.hd-btn--small { min-height: 64px; font-size: 32px; padding: 0 24px; }

/* ---------------------------------------------------------------- Surfaces (kit) */
.hd-panel {
    background-image: url("project://database/Assets/_Project/Art/UI/AubeTactiqueKit/Surfaces/panel-navy.png");
    -unity-slice-left: 40; -unity-slice-top: 40; -unity-slice-right: 40; -unity-slice-bottom: 32;
    padding: 28px 36px;
}
.hd-panel--ivory {
    background-image: url("project://database/Assets/_Project/Art/UI/AubeTactiqueKit/Surfaces/panel-ivory.png");
}
.hd-panel--ivory .hd-text { color: var(--hd-ink); }
.hd-window {
    background-image: url("project://database/Assets/_Project/Art/UI/AubeTactiqueKit/Surfaces/surface-window.png");
    -unity-slice-left: 40; -unity-slice-top: 40; -unity-slice-right: 40; -unity-slice-bottom: 32;
    padding: 36px 48px;
}
.hd-veil { background-color: rgba(10, 17, 26, 0.72); }
.hd-divider { height: 2px; background-color: var(--hd-brass); opacity: 0.6; margin: 12px 0; }

/* ---------------------------------------------------------------- Onglets, puces, champs */
.hd-tab { margin: 0; border-width: 0; border-radius: 0; background-color: rgba(255, 255, 255, 0);
    min-height: 72px; padding: 0 28px; justify-content: center; align-items: center;
    background-image: url("project://database/Assets/_Project/Art/UI/AubeTactiqueKit/Tabs/tab-horizontal-inactive.png");
    -unity-slice-left: 40; -unity-slice-top: 40; -unity-slice-right: 40; -unity-slice-bottom: 24;
    color: var(--hd-muted); -unity-font: var(--hd-font-heading); font-size: 32px; -unity-text-align: middle-center;
}
.hd-tab--active, .hd-tab:checked {
    background-image: url("project://database/Assets/_Project/Art/UI/AubeTactiqueKit/Tabs/tab-horizontal-active.png"); color: var(--hd-ink);
}
.hd-tab:focus { border-color: var(--hd-brass); }
.hd-field {
    min-height: 84px; padding: 0 28px;
    background-image: url("project://database/Assets/_Project/Art/UI/AubeTactiqueKit/Inputs/field-normal.png");
    -unity-slice-left: 32; -unity-slice-top: 32; -unity-slice-right: 32; -unity-slice-bottom: 24;
    color: var(--hd-ivory); -unity-font: var(--hd-font-body); font-size: var(--hd-text-body); -unity-text-align: middle-left; margin: 0;
}
.hd-field:focus { background-image: url("project://database/Assets/_Project/Art/UI/AubeTactiqueKit/Inputs/field-focus.png"); }
.hd-field--error { background-image: url("project://database/Assets/_Project/Art/UI/AubeTactiqueKit/Inputs/field-error.png"); }
.hd-field:disabled { background-image: url("project://database/Assets/_Project/Art/UI/AubeTactiqueKit/Inputs/field-disabled.png"); }
.hd-chip { margin: 0;
    padding: 4px 18px; background-color: rgba(16, 28, 41, 0.78);
    border-width: 1px; border-color: var(--hd-brass); border-radius: 4px;
    color: var(--hd-ivory); -unity-font: var(--hd-font-body); font-size: var(--hd-text-caption);
}
.hd-chip:focus { border-color: var(--hd-ivory); background-color: rgba(214, 175, 91, 0.32); }
.hd-pill {
    flex-direction: row; align-items: center; min-height: 56px; padding: 0 18px 0 8px;
    background-image: url("project://database/Assets/_Project/Art/UI/AubeTactiqueKit/Economy/resource-pill.png");
    -unity-slice-left: 32; -unity-slice-top: 32; -unity-slice-right: 32; -unity-slice-bottom: 24;
}
.hd-pill__icon { width: 40px; height: 40px; margin-right: 12px; -unity-background-scale-mode: scale-to-fit; }
.hd-pill__value { color: var(--hd-ivory); -unity-font: var(--hd-font-title); font-size: 36px; flex-grow: 1; -unity-text-align: middle-right; }

/* ---------------------------------------------------------------- Barres (kit) */
.hd-bar {
    height: 32px;
    background-image: url("project://database/Assets/_Project/Art/UI/AubeTactiqueKit/Controls/bar-track.png");
    -unity-slice-left: 12; -unity-slice-top: 12; -unity-slice-right: 12; -unity-slice-bottom: 12;
    padding: 5px;
}
.hd-bar__fill {
    height: 100%; width: 0;
    background-image: url("project://database/Assets/_Project/Art/UI/AubeTactiqueKit/Controls/bar-neutral-fill.png");
    -unity-slice-left: 8; -unity-slice-top: 8; -unity-slice-right: 8; -unity-slice-bottom: 8;
    -unity-background-image-tint-color: var(--hd-brass);
}
.hd-bar--hp .hd-bar__fill { -unity-background-image-tint-color: var(--hd-hp); }
.hd-bar--fatigue .hd-bar__fill { -unity-background-image-tint-color: var(--hd-fatigue); }
.hd-bar--xp .hd-bar__fill { -unity-background-image-tint-color: var(--hd-info); }

/* ---------------------------------------------------------------- Interrupteur doré */
.hd-toggle { width: 220px; height: 110px; background-image: url("project://database/Assets/_Project/Resources/UI/AubeTactique/Ext/Components/gold-toggle-off.png"); -unity-background-scale-mode: scale-to-fit; }
.hd-toggle--on { background-image: url("project://database/Assets/_Project/Resources/UI/AubeTactique/Ext/Components/gold-toggle-on.png"); }
.hd-toggle:focus { border-width: 2px; border-color: var(--hd-ivory); border-radius: 8px; }

/* ---------------------------------------------------------------- Familles */
.hd-family--matter { color: var(--hd-matter); -unity-background-image-tint-color: var(--hd-matter); }
.hd-family--elemental { color: var(--hd-elemental); -unity-background-image-tint-color: var(--hd-elemental); }
.hd-family--physical-bio { color: var(--hd-physical-bio); -unity-background-image-tint-color: var(--hd-physical-bio); }
.hd-family--perception { color: var(--hd-perception); -unity-background-image-tint-color: var(--hd-perception); }

/* ---------------------------------------------------------------- Plateformes */
/* Le focus n'est visible qu'au clavier et à la manette ; le tactile n'a ni survol ni focus. */
.input--touch .hd-btn:hover { scale: 1 1; }
.input--touch .hd-btn { min-height: 96px; }
.input--gamepad .hd-btn { min-height: 96px; }
.input--gamepad .hd-btn--small { min-height: 72px; }
