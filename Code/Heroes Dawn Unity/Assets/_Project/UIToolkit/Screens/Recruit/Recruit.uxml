<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="page" class="hd-page hd-recruit">
        <ui:VisualElement name="shopTabs" class="hd-shoptabs" />
        <ui:VisualElement class="hd-recruit__main">
            <ui:ScrollView name="recruitScroll" class="hd-recruit__scroll">
                <ui:VisualElement class="hd-recruit__info">
                    <ui:VisualElement class="hd-recruit__headline">
                        <ui:VisualElement class="hd-star" />
                        <ui:Label name="countdown" class="hd-recruit__countdown" />
                    </ui:VisualElement>
                    <ui:Label name="rule" class="hd-recruit__rule" />
                </ui:VisualElement>
                <ui:Label name="empty" class="hd-recruit__empty" />
                <ui:VisualElement name="cards" class="hd-recruit__cards" />
                <ui:VisualElement name="scraps" class="hd-recruit__scraps" />
                <ui:VisualElement class="hd-recruit__actions">
                    <ui:Label name="progress" class="hd-recruit__progress" />
                    <ui:Button name="reroll" class="hd-btn hd-btn--secondary hd-btn--small" />
                    <ui:Button name="registry" class="hd-btn hd-btn--ghost hd-btn--small" />
                </ui:VisualElement>
            </ui:ScrollView>
        </ui:VisualElement>
        <ui:VisualElement name="detail" class="hd-panel hd-recruit__detail">
            <ui:VisualElement class="hd-recruit__dhead">
                <ui:VisualElement class="hd-recruit__dtitle">
                    <ui:Label name="detailName" class="hd-recruit__dname" />
                    <ui:VisualElement class="hd-recruit__dfamily">
                        <ui:VisualElement name="detailFamily" class="hd-famicon" />
                        <ui:Label name="detailRole" class="hd-recruit__drole" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Label name="detailLevel" class="hd-level hd-recruit__dlevel" />
            </ui:VisualElement>
            <ui:Label name="detailRarity" class="hd-recruit__drarity" />
            <ui:VisualElement name="detailStatGrid" class="hd-recruit__dgrid" />
            <ui:Label name="detailStats" class="hd-recruit__dstats" />
            <ui:VisualElement class="hd-recruit__dsection">
                <ui:VisualElement class="hd-star hd-star--small" />
                <ui:Label name="detailSkillsTitle" class="hd-recruit__dsectiontitle" />
                <ui:VisualElement class="hd-recruit__dsectionline" />
            </ui:VisualElement>
            <ui:ScrollView class="hd-recruit__dscroll">
                <ui:VisualElement name="detailSkillList" class="hd-recruit__dskilllist" />
                <ui:Label name="detailSkills" class="hd-recruit__dskills" />
            </ui:ScrollView>
            <ui:Button name="detailRecruit" class="hd-btn hd-btn--primary" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
