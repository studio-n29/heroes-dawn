<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="modal" class="hd-modal">
        <ui:VisualElement name="window" class="hd-window hd-modal__window hd-pop__wide">
            <ui:Label name="title" class="hd-modal__title" />
            <ui:VisualElement class="hd-divider" />
            <ui:ScrollView class="hd-pop__scroll">
                <ui:Label name="reward" class="hd-pop__text" />
                <ui:Label name="fatigueTitle" class="hd-pop__section" />
                <ui:VisualElement name="fatigue" class="hd-pop__rows" />
                <ui:Label name="xpTitle" class="hd-pop__section" />
                <ui:VisualElement name="xp" class="hd-pop__rows" />
                <ui:Label name="verify" class="hd-pop__hint" />
                <ui:Label name="toHq" class="hd-pop__text" />
            </ui:ScrollView>
            <ui:VisualElement class="hd-modal__buttons"><ui:Button name="continue" class="hd-btn hd-btn--primary" /></ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
