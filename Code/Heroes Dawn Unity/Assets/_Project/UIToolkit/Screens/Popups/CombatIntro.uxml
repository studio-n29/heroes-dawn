<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="modal" class="hd-modal hd-intro">
        <ui:Button name="tap" class="hd-intro__tap" />
        <ui:VisualElement class="hd-intro__cols" picking-mode="Ignore">
            <ui:VisualElement class="hd-intro__col hd-intro__col--left" picking-mode="Ignore">
                <ui:Label name="allyTitle" class="hd-intro__title" picking-mode="Ignore" />
                <ui:VisualElement name="allies" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement class="hd-intro__versus" picking-mode="Ignore" />
            <ui:VisualElement class="hd-intro__col hd-intro__col--right" picking-mode="Ignore">
                <ui:Label name="enemyTitle" class="hd-intro__title hd-intro__title--enemy" picking-mode="Ignore" />
                <ui:VisualElement name="enemies" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Button name="skip" class="hd-btn hd-btn--primary hd-intro__skip" />
    </ui:VisualElement>
</ui:UXML>
