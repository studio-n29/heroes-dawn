<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="modal" class="hd-modal">
        <ui:VisualElement name="window" class="hd-window hd-modal__window">
            <ui:Label name="title" class="hd-modal__title" />
            <ui:VisualElement class="hd-divider" />
            <ui:Label name="objectivesTitle" class="hd-pop__section" />
            <ui:Label name="objectives" class="hd-pop__text" />
            <ui:Label name="rewardsTitle" class="hd-pop__section" />
            <ui:Label name="rewards" class="hd-pop__text" />
            <ui:VisualElement class="hd-modal__buttons"><ui:Button name="toHq" class="hd-btn hd-btn--primary" /></ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
