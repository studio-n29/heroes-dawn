<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="modal" class="hd-modal">
        <ui:VisualElement name="window" class="hd-window hd-modal__window hd-friend__window">
            <ui:VisualElement class="hd-hq-titlerow" picking-mode="Ignore">
                <ui:VisualElement class="hd-hq-titlestar" picking-mode="Ignore" />
                <ui:Label name="title" class="hd-modal__title hd-hq-titlerow__label" />
            </ui:VisualElement>
            <ui:VisualElement class="hd-divider" />
            <ui:Label name="hint" class="hd-pop__hint hd-friend__hint" />
            <ui:VisualElement class="hd-friend__fieldrow">
                <ui:VisualElement class="hd-friend__fieldicon" picking-mode="Ignore" />
                <ui:TextField name="field" class="hd-pop__field hd-friend__field" max-length="24" />
            </ui:VisualElement>
            <ui:VisualElement class="hd-modal__buttons hd-friend__buttons">
                <ui:Button name="cancel" class="hd-btn hd-btn--secondary" />
                <ui:Button name="ok" class="hd-btn hd-btn--primary" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
