<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="modal" class="hd-modal">
        <ui:VisualElement name="window" class="hd-window hd-modal__window hd-pop__wide">
            <ui:VisualElement name="art" class="hd-pop__art" />
            <ui:Label name="heading" class="hd-modal__title" />
            <ui:VisualElement class="hd-divider" />
            <ui:ScrollView class="hd-pop__scroll hd-pop__scroll--short"><ui:Label name="text" class="hd-pop__text" /></ui:ScrollView>
            <ui:VisualElement class="hd-modal__buttons">
                <ui:Button name="continue" class="hd-btn hd-btn--primary" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
