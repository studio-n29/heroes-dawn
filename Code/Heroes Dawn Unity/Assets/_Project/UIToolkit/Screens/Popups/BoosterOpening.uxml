<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="modal" class="hd-modal hd-boost">
        <ui:Button name="tap" class="hd-boost__tap" />
        <ui:Label name="title" class="hd-boost__title" />
        <ui:Label name="hint" class="hd-boost__hint" />
        <ui:VisualElement name="pack" class="hd-boost__pack">
            <ui:Label name="packGlyph" class="hd-boost__packglyph" text="✦" />
        </ui:VisualElement>
        <ui:VisualElement name="cards" class="hd-boost__cards" />
        <ui:Button name="skip" class="hd-btn hd-btn--ghost hd-boost__skip" />
        <ui:Button name="continue" class="hd-btn hd-btn--primary hd-boost__continue" />
        <ui:VisualElement name="flash" class="hd-boost__flash" />
    </ui:VisualElement>
</ui:UXML>
