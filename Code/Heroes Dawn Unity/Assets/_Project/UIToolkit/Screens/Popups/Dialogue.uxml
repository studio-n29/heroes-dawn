<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="modal" class="hd-modal">
        <ui:VisualElement name="window" class="hd-window hd-modal__window hd-story">
            <ui:Label name="title" class="hd-modal__title" />
            <ui:Label name="progress" class="hd-pop__hint" />
            <ui:VisualElement class="hd-res__divider" />
            <ui:Label name="prompt" class="hd-pop__text" />
            <ui:Label name="reaction" class="hd-pop__section" />
            <ui:VisualElement name="choices" class="hd-pop__choices" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
