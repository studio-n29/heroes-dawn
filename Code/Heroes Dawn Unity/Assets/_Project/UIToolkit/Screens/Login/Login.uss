/* Écran titre (planche 1.1) : panorama de New York à l'aube, héroïne détourée, logotype posé sur l'illustration, Jouer et Se connecter en bas à droite, cadre fin laiton. */
.login { background-color: #101C29; }
.login__backdrop {
    position: absolute; left: 0; top: 0; right: 0; bottom: 0;
    background-image: url("project://database/Assets/_Project/Resources/UI/AubeTactique/hq-new-york.png");
    -unity-background-scale-mode: scale-and-crop;
}
/* Voile léger sur toute l'image ; les deux dégradés font la lisibilité du logotype (haut) et des boutons (bas). */
.login__veil {
    position: absolute; left: 0; top: 0; right: 0; bottom: 0;
    background-color: rgba(10, 17, 26, 0.16);
}
.login__shade { position: absolute; left: 0; right: 0; -unity-background-scale-mode: stretch-to-fill; }
.login__shade--top {
    top: 0; height: 46%; opacity: 0.85;
    background-image: url("project://database/Assets/_Project/Art/UI/AubeTactiqueKit/Overlays/gradient-dark-top.png");
}
.login__shade--bottom {
    bottom: 0; height: 44%; opacity: 0.8;
    background-image: url("project://database/Assets/_Project/Art/UI/AubeTactiqueKit/Overlays/gradient-dark-bottom.png");
}
.login__hero {
    position: absolute; left: 0; bottom: 0; width: 46%; height: 100%;
    background-image: url("project://database/Assets/_Project/Resources/UI/AubeTactique/Ext/Agents/giulia_rossi-cutout.png");
    -unity-background-scale-mode: scale-to-fit;
}

/* Cadre : filet laiton à 16 px du bord, coins haut gauche et bas droit marqués d'un triangle laiton (carré tourné, rogné par son conteneur). */
.login__frame {
    position: absolute; left: 16px; top: 16px; right: 16px; bottom: 16px;
    border-width: 2px; border-color: rgba(214, 175, 91, 0.8);
}
.login__corner { position: absolute; width: 44px; height: 44px; overflow: hidden; }
.login__corner--tl { left: 0; top: 0; }
.login__corner--br { right: 0; bottom: 0; }
.login__cornerfill { position: absolute; width: 60px; height: 60px; background-color: #D6AF5B; rotate: 45deg; }
.login__corner--tl > .login__cornerfill { left: -30px; top: -30px; }
.login__corner--br > .login__cornerfill { left: 14px; top: 14px; }

.login__safe { flex-direction: column; }

/* Logotype : directement sur l'illustration, sans cartouche. */
.login__lockup {
    position: absolute; right: 6%; top: 10%; width: 820px;
    align-items: center;
}
.login__logo { width: 820px; height: 123px; flex-direction: row; flex-shrink: 0; }
.login__logoclip { height: 123px; overflow: hidden; flex-shrink: 0; }
.login__logoclip--left { width: 377px; }
.login__logoclip--star { width: 111px; }
.login__logoclip--right { width: 332px; }
.login__logoimg {
    position: absolute; top: 0; width: 820px; height: 123px;
    background-image: url("project://database/Assets/_Project/Art/UI/AubeTactiqueKit/Brand/heroes-dawn-ivory.png");
    -unity-background-scale-mode: scale-to-fit;
}
.login__logoimg--left { left: 0; }
.login__logoimg--star {
    left: -377px;
    background-image: url("project://database/Assets/_Project/Art/UI/AubeTactiqueKit/Brand/heroes-dawn-gold.png");
}
.login__logoimg--right { left: -488px; }

/* Actions : bloc compact en bas à droite, Jouer (ivoire, étoile et chevron) au-dessus de Se connecter. */
.login__actions { position: absolute; right: 5%; bottom: 8%; width: 580px; }
.login__play { height: 104px; font-size: 50px; padding: 0 88px; margin-bottom: 14px; }
.login__account { height: 72px; min-height: 72px; font-size: 34px; padding: 0 76px; margin: 0 28px; }
.login__btnicon { position: absolute; top: 0; bottom: 0; -unity-background-scale-mode: scale-to-fit; }
.login__btnicon--star {
    left: 30px; width: 46px;
    background-image: url("project://database/Assets/_Project/Art/UI/AubeTactiqueKit/IconsGold/dawn.png");
}
.login__btnicon--chevron {
    right: 26px; width: 38px;
    background-image: url("project://database/Assets/_Project/Art/UI/AubeTactiqueKit/Icons/forward.png");
    -unity-background-image-tint-color: #101C29;
}
.login__btnicon--account {
    left: 28px; width: 36px;
    background-image: url("project://database/Assets/_Project/Art/UI/AubeTactiqueKit/Icons/account.png");
    -unity-background-image-tint-color: #ECE7DC;
}
.login__status { margin-bottom: 12px; min-height: 36px; }
.login__spinner {
    width: 70px; height: 70px; align-self: center; margin-bottom: 14px; display: none;
    background-image: url("project://database/Assets/_Project/Art/UI/AubeTactiqueKit/Indicators/spinner-00.png");
    -unity-background-scale-mode: scale-to-fit;
}
.login__studio { position: absolute; left: 3%; bottom: 4%; color: #ECE7DC; opacity: 0.85; font-size: 28px; }
/* Apparition du logotype. */
.login__lockup { opacity: 0; scale: 0.92 0.92; transition: opacity 0.5s ease-out, scale 0.5s ease-out; }
.login__lockup--in { opacity: 1; scale: 1 1; }
