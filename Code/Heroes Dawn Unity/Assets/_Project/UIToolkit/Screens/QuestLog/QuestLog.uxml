<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="modal" class="hd-modal">
        <ui:VisualElement name="window" class="hd-window hd-modal__window hd-quests__window">
            <ui:VisualElement class="hd-hq-titlerow" picking-mode="Ignore">
                <ui:VisualElement class="hd-hq-titlestar" picking-mode="Ignore" />
                <ui:Label name="title" class="hd-modal__title hd-hq-titlerow__label" />
            </ui:VisualElement>
            <ui:VisualElement class="hd-divider" />
            <ui:ScrollView name="body" class="hd-quests__body" />
            <ui:VisualElement class="hd-modal__buttons hd-form__row">
                <ui:Button name="close" class="hd-btn hd-btn--secondary hd-btn--small" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
