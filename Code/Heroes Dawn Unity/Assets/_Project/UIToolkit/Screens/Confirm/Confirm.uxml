<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="modal" class="hd-modal">
        <ui:VisualElement name="window" class="hd-window hd-modal__window">
            <ui:Label name="title" class="hd-modal__title" />
            <ui:VisualElement class="hd-divider" />
            <ui:Label name="body" class="hd-modal__body" />
            <ui:VisualElement class="hd-modal__buttons">
                <ui:Button name="cancel" class="hd-btn hd-btn--secondary" />
                <ui:Button name="ok" class="hd-btn hd-btn--primary" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
